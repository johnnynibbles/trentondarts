@{
    var leagueId = ViewContext.RouteData.Values["leagueId"]?.ToString() ?? "1";
    var currentPath = Context.Request.Path.ToString().ToLower();
    bool IsActive(string segment) => currentPath.Contains("/" + segment);
    string ActiveLinkStyle(string segment) => IsActive(segment)
        ? "color:#C8962E;text-decoration:none;background:rgba(200,150,46,0.1)"
        : "color:#F5ECD7;text-decoration:none";
    bool SiteGroupActive() => IsActive("dartevents") || IsActive("pageparts") || IsActive("navigation") || IsActive("documents");
    bool LeagueGroupActive() => IsActive("players") || IsActive("teams") || IsActive("sponsors") || IsActive("boardmembers") || IsActive("matchtypes");
    bool CanManageUsers() => User.IsInRole("Owner") || User.IsInRole("Admin");
}
<nav style="background:rgba(10,10,11,0.9);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,0.08);position:sticky;top:0;z-index:50">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between h-12">

            <a href="/Manage/@leagueId" class="text-sm font-bold tracking-widest uppercase" style="font-family:'Rajdhani',sans-serif;color:#C8962E;text-decoration:none">
                <i class="fa-solid fa-screwdriver-wrench mr-1"></i>Manage
            </a>

            <ul class="hidden md:flex items-center gap-1 list-none m-0 p-0">
                <li class="nav-dropdown-parent relative" style="list-style:none">
                    <button class="nav-dropdown-toggle flex items-center gap-1 px-3 py-2 text-sm rounded-md"
                            style="background:transparent;border:none;color:@(SiteGroupActive() ? "#C8962E" : "#F5ECD7");cursor:pointer;font-family:'Inter',sans-serif">
                        Site <i class="fa-solid fa-chevron-down text-xs ml-1" style="color:#6B7280"></i>
                    </button>
                    <ul class="nav-dropdown-menu hidden absolute left-0 top-full mt-1 min-w-[180px] rounded-xl py-1 list-none p-0"
                        style="background:#111214;border:1px solid rgba(255,255,255,0.1);box-shadow:0 8px 32px rgba(0,0,0,0.5)">
                        <li style="list-style:none"><a href="/Manage/@leagueId/dartevents" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("dartevents")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Dart Events</a></li>
                        <li style="list-style:none"><a href="/Manage/@leagueId/pageparts" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("pageparts")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Page Content</a></li>
                        <li style="list-style:none"><a href="/Manage/@leagueId/navigation" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("navigation")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Navigation</a></li>
                        <li style="list-style:none"><a href="/Manage/@leagueId/documents" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("documents")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Documents</a></li>
                    </ul>
                </li>
                <li class="nav-dropdown-parent relative" style="list-style:none">
                    <button class="nav-dropdown-toggle flex items-center gap-1 px-3 py-2 text-sm rounded-md"
                            style="background:transparent;border:none;color:@(LeagueGroupActive() ? "#C8962E" : "#F5ECD7");cursor:pointer;font-family:'Inter',sans-serif">
                        League <i class="fa-solid fa-chevron-down text-xs ml-1" style="color:#6B7280"></i>
                    </button>
                    <ul class="nav-dropdown-menu hidden absolute left-0 top-full mt-1 min-w-[180px] rounded-xl py-1 list-none p-0"
                        style="background:#111214;border:1px solid rgba(255,255,255,0.1);box-shadow:0 8px 32px rgba(0,0,0,0.5)">
                        <li style="list-style:none"><a href="/Manage/@leagueId/players" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("players")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Players</a></li>
                        <li style="list-style:none"><a href="/Manage/@leagueId/teams" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("teams")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Teams</a></li>
                        <li style="list-style:none"><a href="/Manage/@leagueId/sponsors" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("sponsors")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Sponsors</a></li>
                        <li style="list-style:none"><a href="/Manage/@leagueId/boardmembers" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("boardmembers")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Board Members</a></li>
                        <li style="list-style:none"><a href="/Manage/@leagueId/matchtypes" class="block px-3 py-2 text-sm" style="@ActiveLinkStyle("matchtypes")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Match Types</a></li>
                    </ul>
                </li>
                <li style="list-style:none"><a href="/Manage/@leagueId/seasons" class="px-3 py-2 text-sm rounded-md block" style="@ActiveLinkStyle("seasons")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Seasons</a></li>
                @if (CanManageUsers())
                {
                    <li style="list-style:none"><a href="/Manage/@leagueId/users" class="px-3 py-2 text-sm rounded-md block" style="@ActiveLinkStyle("users")" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background=''">Users</a></li>
                }
            </ul>

            <div class="hidden md:flex items-center gap-3">
                <a href="/" class="text-xs" style="color:#6B7280;text-decoration:none"><i class="fa-solid fa-arrow-left mr-1"></i>Public Site</a>
                <a href="/Auth/Logout" class="px-3 py-1.5 text-xs rounded-md" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);color:#F5ECD7;text-decoration:none">Logout</a>
            </div>

            <button id="manage-hamburger" class="md:hidden p-2 rounded-md" style="background:transparent;border:none;cursor:pointer" aria-label="Open menu">
                <i class="fa-solid fa-bars" style="color:#F5ECD7"></i>
            </button>
        </div>
    </div>

    <div id="manage-mobile-menu" class="hidden md:hidden px-4 py-3" style="border-top:1px solid rgba(255,255,255,0.08);background:#0D0D0E">
        <p class="text-xs font-semibold uppercase tracking-widest mb-2" style="color:#C8962E">Site</p>
        <a href="/Manage/@leagueId/dartevents" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Dart Events</a>
        <a href="/Manage/@leagueId/pageparts" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Page Content</a>
        <a href="/Manage/@leagueId/navigation" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Navigation</a>
        <a href="/Manage/@leagueId/documents" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Documents</a>
        <p class="text-xs font-semibold uppercase tracking-widest mt-3 mb-2" style="color:#C8962E">League</p>
        <a href="/Manage/@leagueId/players" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Players</a>
        <a href="/Manage/@leagueId/teams" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Teams</a>
        <a href="/Manage/@leagueId/sponsors" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Sponsors</a>
        <a href="/Manage/@leagueId/boardmembers" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Board Members</a>
        <a href="/Manage/@leagueId/matchtypes" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Match Types</a>
        <a href="/Manage/@leagueId/seasons" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Seasons</a>
        @if (CanManageUsers())
        {
            <a href="/Manage/@leagueId/users" class="block py-2 text-sm border-b" style="color:#F5ECD7;text-decoration:none;border-color:rgba(255,255,255,0.05)">Users</a>
        }
        <div class="mt-3 pt-3 flex gap-4" style="border-top:1px solid rgba(255,255,255,0.08)">
            <a href="/" class="text-sm" style="color:#6B7280;text-decoration:none">Public Site</a>
            <a href="/Auth/Logout" class="text-sm" style="color:#F5ECD7;text-decoration:none">Logout</a>
        </div>
    </div>
</nav>

<script>
(function () {
    var hamburger = document.getElementById('manage-hamburger');
    var menu = document.getElementById('manage-mobile-menu');
    if (hamburger) hamburger.addEventListener('click', function () { menu.classList.toggle('hidden'); });

    document.querySelectorAll('.nav-dropdown-parent').forEach(function (parent) {
        var toggle = parent.querySelector('.nav-dropdown-toggle');
        var dropdown = parent.querySelector('.nav-dropdown-menu');
        if (!toggle || !dropdown) return;
        toggle.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = !dropdown.classList.contains('hidden');
            document.querySelectorAll('.nav-dropdown-menu').forEach(function (m) { m.classList.add('hidden'); });
            if (!isOpen) dropdown.classList.remove('hidden');
        });
    });

    document.addEventListener('click', function () {
        document.querySelectorAll('.nav-dropdown-menu').forEach(function (m) { m.classList.add('hidden'); });
    });
})();
</script>

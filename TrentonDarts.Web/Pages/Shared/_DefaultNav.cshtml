@using Microsoft.AspNetCore.Http
@inject TrentonDarts.Web.Services.NavService NavService
@{
    var nav = await NavService.GetDefaultNavAsync();
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var isAdmin = isAuthenticated && User.IsInRole("Admin");
    var isBoardMember = isAuthenticated && await NavService.IsBoardMemberAsync(User);
}
<nav style="background:rgba(249,250,251,0.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid #E5E7EB;position:sticky;top:0;z-index:50">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px">
        <div class="flex items-center justify-between" style="height:56px">

            @* Logo *@
            <a href="/" class="flex items-center gap-2.5" style="text-decoration:none;color:inherit;flex-shrink:0">
                <img src="/images/trentondarts-logo.png" alt="GTDL" style="height:36px;width:36px;object-fit:contain;display:block">
                <span class="hidden sm:block" style="font-size:13px;color:#6B7280;font-weight:500">Greater Trenton Dart League</span>
            </a>

            @* Desktop nav links *@
            <ul class="hidden md:flex items-center gap-0.5 list-none m-0 p-0">
                @foreach (var item in nav)
                {
                    if (item.SubItems.Count > 0)
                    {
                        <li class="nav-dropdown-parent relative" style="list-style:none">
                            <button class="nav-dropdown-toggle flex items-center gap-1 px-3 py-1.5 rounded text-sm font-medium transition-colors"
                                    style="background:transparent;border:none;color:#374151;cursor:pointer;font-family:inherit"
                                    aria-expanded="false">
                                @item.Title
                                <i class="fa-solid fa-chevron-down text-xs" style="color:#9CA3AF"></i>
                            </button>
                            <ul class="nav-dropdown-menu hidden absolute left-0 top-full mt-1 min-w-45 rounded-xl py-1 list-none p-0"
                                style="background:#FFFFFF;border:1px solid #E5E7EB;box-shadow:0 8px 32px rgba(0,0,0,0.12)">
                                @foreach (var sub in item.SubItems)
                                {
                                    if (sub.IsHeader)
                                    {
                                        <li class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-widest" style="color:#2563EB;list-style:none">@sub.Title</li>
                                    }
                                    else if (sub.IsSeparator)
                                    {
                                        <li style="border-top:1px solid #E5E7EB;margin:4px 0;list-style:none"></li>
                                    }
                                    else
                                    {
                                        <li style="list-style:none">
                                            <a href="@sub.Url" class="block px-3 py-2 text-sm transition-colors"
                                               style="color:#374151;text-decoration:none"
                                               @(sub.OpenInNewTab ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "")
                                               onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                                                @sub.Title
                                                @if (sub.OpenInNewTab && !sub.IsDocument)
                                                {
                                                    <i class="fa-solid fa-arrow-up-right-from-square text-xs ml-1" style="color:#9CA3AF"></i>
                                                }
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li style="list-style:none">
                            <a href="@item.Url" class="px-3 py-1.5 text-sm font-medium rounded block transition-colors"
                               style="color:#374151;text-decoration:none"
                               onmouseover="this.style.background='#F3F4F6'" onmouseout="this.style.background=''">
                                @item.Title
                            </a>
                        </li>
                    }
                }
            </ul>

            @* Desktop right: auth *@
            <div class="hidden md:flex items-center gap-2">
                @if (isAuthenticated)
                {
                    <div class="nav-dropdown-parent relative">
                        <button class="nav-dropdown-toggle flex items-center gap-2 px-3 py-1.5 text-sm font-medium rounded transition-colors"
                                style="background:#F3F4F6;border:1px solid #E5E7EB;color:#374151;cursor:pointer;font-family:inherit"
                                aria-expanded="false">
                            <i class="fa-solid fa-circle-user" style="color:#2563EB"></i>
                            @User.Identity!.Name
                            <i class="fa-solid fa-chevron-down text-xs" style="color:#9CA3AF"></i>
                        </button>
                        <ul class="nav-dropdown-menu hidden absolute right-0 top-full mt-1 min-w-40 rounded-xl py-1 list-none p-0"
                            style="background:#FFFFFF;border:1px solid #E5E7EB;box-shadow:0 8px 32px rgba(0,0,0,0.12)">
                            @if (isAdmin || isBoardMember)
                            {
                                <li class="px-3 pt-2 pb-1 text-xs font-semibold uppercase tracking-widest" style="color:#2563EB;list-style:none">Manage</li>
                                <li style="list-style:none">
                                    <a href="/manage/1" class="block px-3 py-2 text-sm" style="color:#374151;text-decoration:none"
                                       onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">League</a>
                                </li>
                                <li style="border-top:1px solid #E5E7EB;margin:4px 0;list-style:none"></li>
                            }
                            <li style="list-style:none">
                                <a href="/Auth/Logout" class="block px-3 py-2 text-sm" style="color:#374151;text-decoration:none"
                                   onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">Logout</a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/Auth/Login" class="px-3 py-1.5 text-sm font-medium rounded"
                       style="background:transparent;border:1px solid #E5E7EB;color:#374151;text-decoration:none"
                       onmouseover="this.style.background='#F3F4F6'" onmouseout="this.style.background=''">Log in</a>
                    <a href="/Auth/Register" class="px-3 py-1.5 text-sm font-semibold rounded"
                       style="background:#2563EB;border:1px solid #2563EB;color:#fff;text-decoration:none"
                       onmouseover="this.style.background='#1D4ED8'" onmouseout="this.style.background='#2563EB'">Register</a>
                }
            </div>

            @* Hamburger *@
            <button id="nav-hamburger" class="md:hidden flex flex-col gap-1.5 p-2 rounded"
                    style="background:transparent;border:1px solid #E5E7EB;cursor:pointer" aria-label="Open menu">
                <span class="block w-5 h-0.5" style="background:#374151"></span>
                <span class="block w-5 h-0.5" style="background:#374151"></span>
                <span class="block w-5 h-0.5" style="background:#374151"></span>
            </button>
        </div>
    </div>

    @* Mobile menu *@
    <div id="nav-mobile-menu" class="hidden md:hidden border-t px-4 py-3" style="border-color:#E5E7EB;background:#FFFFFF">
        @foreach (var item in nav)
        {
            if (item.SubItems.Count > 0)
            {
                <div class="mobile-section mb-2">
                    <button class="mobile-section-toggle flex items-center justify-between w-full py-2 text-sm font-semibold"
                            style="background:transparent;border:none;color:#2563EB;cursor:pointer;font-family:inherit;letter-spacing:0.04em;text-transform:uppercase">
                        @item.Title
                        <i class="fa-solid fa-chevron-down text-xs transition-transform" style="color:#9CA3AF"></i>
                    </button>
                    <div class="mobile-section-items hidden pl-3">
                        @foreach (var sub in item.SubItems)
                        {
                            if (sub.IsHeader)
                            {
                                <p class="py-1 text-xs font-semibold uppercase tracking-widest" style="color:#9CA3AF">@sub.Title</p>
                            }
                            else if (!sub.IsSeparator)
                            {
                                <a href="@sub.Url" class="block py-2 text-sm border-b"
                                   style="color:#374151;text-decoration:none;border-color:#F3F4F6"
                                   @(sub.OpenInNewTab ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "")>
                                    @sub.Title
                                    @if (sub.OpenInNewTab && !sub.IsDocument) { <i class="fa-solid fa-arrow-up-right-from-square text-xs ml-1" style="color:#9CA3AF"></i> }
                                </a>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <a href="@item.Url" class="block py-2 text-sm border-b" style="color:#374151;text-decoration:none;border-color:#F3F4F6">@item.Title</a>
            }
        }
        <div class="mt-3 pt-3" style="border-top:1px solid #E5E7EB">
            @if (isAuthenticated)
            {
                @if (isAdmin || isBoardMember)
                {
                    <a href="/manage/1" class="block py-2 text-sm" style="color:#2563EB;text-decoration:none">Manage League</a>
                }
                <a href="/Auth/Logout" class="block py-2 text-sm" style="color:#374151;text-decoration:none">Logout</a>
            }
            else
            {
                <a href="/Auth/Login" class="block py-2 text-sm" style="color:#374151;text-decoration:none">Log in</a>
                <a href="/Auth/Register" class="block py-2 text-sm font-semibold" style="color:#2563EB;text-decoration:none">Register</a>
            }
        </div>
    </div>
</nav>

<script>
(function () {
    var hamburger = document.getElementById('nav-hamburger');
    var mobileMenu = document.getElementById('nav-mobile-menu');
    hamburger.addEventListener('click', function () {
        mobileMenu.classList.toggle('hidden');
    });

    document.querySelectorAll('.nav-dropdown-parent').forEach(function (parent) {
        var toggle = parent.querySelector('.nav-dropdown-toggle');
        var menu = parent.querySelector('.nav-dropdown-menu');
        if (!toggle || !menu) return;
        toggle.addEventListener('click', function (e) {
            e.stopPropagation();
            var isOpen = !menu.classList.contains('hidden');
            document.querySelectorAll('.nav-dropdown-menu').forEach(function (m) { m.classList.add('hidden'); });
            if (!isOpen) menu.classList.remove('hidden');
        });
    });

    document.querySelectorAll('.mobile-section-toggle').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var items = btn.nextElementSibling;
            items.classList.toggle('hidden');
            var icon = btn.querySelector('i');
            if (icon) icon.style.transform = items.classList.contains('hidden') ? '' : 'rotate(180deg)';
        });
    });

    document.addEventListener('click', function () {
        document.querySelectorAll('.nav-dropdown-menu').forEach(function (m) { m.classList.add('hidden'); });
    });
})();
</script>

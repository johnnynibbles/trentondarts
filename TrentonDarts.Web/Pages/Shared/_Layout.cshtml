@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" content="notranslate">
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>Greater Trenton Dart League</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="~/dist/main.css" rel="stylesheet" type="text/css" asp-append-version="true">
</head>
<body class="min-h-screen flex flex-col" style="background:var(--color-bg);color:var(--color-text)">

<div id="site-nav">
    @await Html.PartialAsync("_DefaultNav")
</div>

<main class="flex-1 site-shell">
    @RenderBody()
</main>

<div class="bridge-strip no-print">
    <img src="/images/trenton-makes-thin.jpg" alt="">
</div>

<footer id="site-footer" class="mt-auto no-print" style="border-top:1px solid var(--color-border)">
    <div class="mx-auto grid gap-4 px-6 py-5 sm:grid-cols-[2fr_1fr] items-center" style="max-width:var(--max-w)">
        <div>
            <div class="inline-flex items-center gap-3">
                <span style="background:#fff;border-radius:8px;padding:6px;display:inline-flex">
                    <img src="/images/trentondarts-logo.png" alt="GTDL" style="width:36px;height:36px;object-fit:contain">
                </span>
                <div>
                    <p class="text-sm font-bold" style="color:var(--color-gold)">GTDL</p>
                    <p class="text-xs" style="color:var(--color-muted)">Greater Trenton Dart League</p>
                </div>
            </div>
        </div>
        <a href="http://www.facebook.com/GreaterTrentonDartLeague" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm sm:justify-end" style="color:var(--color-text)">
            <i class="fa-brands fa-facebook text-lg" style="color:var(--color-gold)"></i>
            <span>Facebook</span>
        </a>
    </div>
    <div class="mx-auto px-6 pb-4 text-xs" style="max-width:var(--max-w);color:var(--color-muted)">&copy; Greater Trenton Dart League</div>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

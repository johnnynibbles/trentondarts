@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>Greater Trenton Dart League</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="~/dist/main.css" rel="stylesheet" type="text/css" asp-append-version="true">
</head>
<body class="min-h-screen flex flex-col" style="background-color:#0A0A0B;color:#F5ECD7">

<header id="site-header" style="border-bottom:1px solid rgba(255,255,255,0.08)">
    <div class="max-w-7xl mx-auto px-4 py-5 text-center">
        <a href="/" class="block no-underline hover:no-underline">
            <span class="block text-4xl sm:text-5xl font-bold tracking-widest uppercase" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Greater Trenton</span>
            <span class="block text-lg sm:text-xl font-semibold tracking-[0.2em] uppercase" style="font-family:'Rajdhani',sans-serif;color:#C8962E">Dart League</span>
        </a>
    </div>
</header>

<div id="site-nav">
    @await Html.PartialAsync("_DefaultNav")
</div>

<main class="flex-1 w-full max-w-7xl mx-auto px-4 py-6 pb-24 md:pb-6">
    @RenderBody()
</main>

<footer id="site-footer" class="mt-auto py-5 px-4 text-center no-print" style="border-top:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.02)">
    <div class="flex items-center justify-center gap-4">
        <a href="http://www.facebook.com/GreaterTrentonDartLeague" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm" style="color:#9CA3AF">
            <i class="fa-brands fa-facebook text-xl" style="color:#C8962E"></i>
            <span>Greater Trenton Dart League on Facebook</span>
        </a>
    </div>
    <p class="mt-2 text-xs" style="color:#6B7280">&copy; Greater Trenton Dart League</p>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

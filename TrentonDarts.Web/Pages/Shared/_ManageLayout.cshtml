@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" content="notranslate">
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>Greater Trenton Dart League - Manage</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="~/dist/main.css" rel="stylesheet" type="text/css" asp-append-version="true">
</head>
<body class="min-h-screen flex flex-col" style="background-color:#F9FAFB;color:#111827">

@await Html.PartialAsync("_ManageNav")

<main class="flex-1 w-full max-w-7xl mx-auto px-4 py-6">
    @RenderBody()
</main>

<footer class="py-4 text-center text-xs" style="border-top:1px solid #E5E7EB;color:#6B7280">
    &copy; Greater Trenton Dart League — <a href="/" style="color:#2563EB;text-decoration:none">Public Site</a>
</footer>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@page "/sponsors"
@model TrentonDarts.Web.Pages.Sponsors.IndexModel
@{
    ViewData["Title"] = "GTDL Sponsors";
}

<h2 class="text-2xl font-bold mb-5" style="color:#111827">GTDL Sponsors</h2>

<div class="flex flex-wrap gap-2 mb-5">
    @foreach (var kv in Model.SponsorTypes)
    {
        <a href="/sponsors?type=@kv.Key"
           class="px-3 py-1.5 rounded-full text-sm font-medium"
           style="@(Model.SelectedType == kv.Key ? "background:#2563EB;color:#fff" : "background:#F3F4F6;color:#374151;border:1px solid #E5E7EB");text-decoration:none">
            @kv.Value
        </a>
    }
</div>

<div class="glass-card overflow-x-auto">
    <table class="w-full text-sm">
        <thead>
            <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Name</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Address</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Contact</th>
                <th class="px-3 py-2 text-center text-xs" style="color:#6B7280"></th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280;width:30%">Description</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Sponsors.Any())
        {
            <tr><td colspan="5" class="px-3 py-6 text-center text-sm" style="color:#6B7280">Currently No Sponsors</td></tr>
        }
        else
        {
            @foreach (var s in Model.Sponsors)
            {
                <tr style="border-bottom:1px solid #F3F4F6"
                    onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                    <td class="px-3 py-2 font-semibold">
                        @if (!string.IsNullOrEmpty(s.Url))
                        {
                            <a href="@s.Url" target="_blank" style="color:#2563EB;text-decoration:none">@s.Name</a>
                        }
                        else
                        {
                            <span style="color:#111827">@s.Name</span>
                        }
                    </td>
                    <td class="px-3 py-2 text-xs" style="color:#6B7280">
                        @if (!string.IsNullOrEmpty(s.Address1))
                        {
                            if (!string.IsNullOrEmpty(s.MapUrl))
                            {
                                <a href="@s.MapUrl" target="_blank" style="color:#6B7280;text-decoration:none">
                                    @s.Address1<br/>
                                    @if (!string.IsNullOrEmpty(s.Address2)) { @s.Address2 <br/> }
                                    @s.City, @s.State @s.Zip
                                </a>
                            }
                            else
                            {
                                @s.Address1<br/>
                                @if (!string.IsNullOrEmpty(s.Address2)) { @s.Address2 <br/> }
                                @:@s.City, @s.State @s.Zip
                            }
                        }
                    </td>
                    <td class="px-3 py-2 text-xs" style="color:#6B7280">
                        <div>@s.Phone</div>
                        <div>@s.Email</div>
                    </td>
                    <td class="px-3 py-2 text-center">
                        @if (!string.IsNullOrEmpty(s.FacebookUrl))
                        {
                            <a href="@s.FacebookUrl" target="_blank" style="color:#2563EB;font-size:1.25rem"><i class="fa-brands fa-facebook"></i></a>
                        }
                    </td>
                    <td class="px-3 py-2 text-xs" style="color:#6B7280">
                        @foreach (var t in s.Teams)
                        {
                            <div>@t.Name</div>
                        }
                        <div>@s.Description</div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

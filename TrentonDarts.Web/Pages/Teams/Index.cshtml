@page "/teams"
@model TrentonDarts.Web.Pages.Teams.IndexModel
@{
    ViewData["Title"] = $"{Model.Season.Name} Teams";
}

<div class="team-list-page">
    <h2 style="text-align:center;">@Model.Season.Name GTDL Teams</h2>
    <div class="container-fluid">
        <table class="table table-striped table-hover table-align-middle">
            <thead>
                <tr>
                    <th>Team</th>
                    <th>Sponsor</th>
                    <th></th>
                    <th>Address</th>
                    <th>Captains</th>
                    <th style="text-align:center">Pre</th>
                    <th style="text-align:center">Regular</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.SeasonTeams.Any())
            {
                <tr class="warning"><td colspan="7">Currently No Teams</td></tr>
            }
            else
            {
                @foreach (var st in Model.SeasonTeams.OrderBy(t => t.Team.Name))
                {
                    var sponsor = st.Team.Sponsor;
                    <tr>
                        <td><a href="/team/@st.Team.Id"><strong>@st.Team.Name</strong></a></td>
                        <td>
                            @if (sponsor != null)
                            {
                                if (!string.IsNullOrEmpty(sponsor.Url))
                                {
                                    <a href="@sponsor.Url" target="_blank"><strong>@sponsor.Name</strong></a>
                                }
                                else
                                {
                                    <strong>@sponsor.Name</strong>
                                }
                                if (!string.IsNullOrEmpty(sponsor.Phone))
                                {
                                    <div style="font-size:.8em;"><strong>Ph: </strong>@sponsor.Phone</div>
                                }
                            }
                        </td>
                        <td>
                            @if (sponsor != null && !string.IsNullOrEmpty(sponsor.FacebookUrl))
                            {
                                <a href="@sponsor.FacebookUrl" target="_blank"><i class="fa fa-facebook-official fa-2x"></i></a>
                            }
                        </td>
                        <td>
                            @if (sponsor != null && !string.IsNullOrEmpty(sponsor.Address1))
                            {
                                <a href="@sponsor.MapUrl" target="_blank">
                                    @sponsor.Address1<br/>
                                    @if (!string.IsNullOrEmpty(sponsor.Address2)) { @sponsor.Address2 <br/> }
                                    @sponsor.City, @sponsor.State @sponsor.Zip
                                </a>
                            }
                        </td>
                        <td>
                            @foreach (var tp in st.TeamPlayers)
                            {
                                @tp.Player?.Name<br/>
                            }
                        </td>
                        <td style="text-align:center">@st.PreSeasonDiv</td>
                        <td style="text-align:center">@st.RegularSeasonDiv</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@page "/teams"
@model TrentonDarts.Web.Pages.Teams.IndexModel
@{
    ViewData["Title"] = $"{Model.Season.Name} Teams";
}

<h2 class="text-3xl font-bold mb-5 text-center" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">@Model.Season.Name GTDL Teams</h2>

<div class="glass-card overflow-x-auto">
    <table class="w-full text-sm">
        <thead>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Team</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Sponsor</th>
                <th class="px-3 py-2 text-center text-xs" style="color:#9CA3AF"></th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Address</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Captains</th>
                <th class="px-3 py-2 text-center text-xs font-semibold" style="color:#9CA3AF">Pre</th>
                <th class="px-3 py-2 text-center text-xs font-semibold" style="color:#9CA3AF">Regular</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.SeasonTeams.Any())
        {
            <tr><td colspan="7" class="px-3 py-6 text-center text-sm" style="color:#6B7280">Currently No Teams</td></tr>
        }
        else
        {
            @foreach (var st in Model.SeasonTeams.OrderBy(t => t.Team.Name))
            {
                var sponsor = st.Team.Sponsor;
                <tr style="border-bottom:1px solid rgba(255,255,255,0.06)"
                    onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
                    <td class="px-3 py-2 font-semibold">
                        <a href="/team/@st.Team.Id" style="color:#C8962E;text-decoration:none">@st.Team.Name</a>
                    </td>
                    <td class="px-3 py-2">
                        @if (sponsor != null)
                        {
                            if (!string.IsNullOrEmpty(sponsor.Url))
                            {
                                <a href="@sponsor.Url" target="_blank" style="color:#F5ECD7;text-decoration:none;font-weight:600">@sponsor.Name</a>
                            }
                            else
                            {
                                <strong style="color:#F5ECD7">@sponsor.Name</strong>
                            }
                            if (!string.IsNullOrEmpty(sponsor.Phone))
                            {
                                <div class="text-xs" style="color:#6B7280">@sponsor.Phone</div>
                            }
                        }
                    </td>
                    <td class="px-3 py-2 text-center">
                        @if (sponsor != null && !string.IsNullOrEmpty(sponsor.FacebookUrl))
                        {
                            <a href="@sponsor.FacebookUrl" target="_blank" style="color:#C8962E;font-size:1.1rem"><i class="fa-brands fa-facebook"></i></a>
                        }
                    </td>
                    <td class="px-3 py-2 text-xs" style="color:#9CA3AF">
                        @if (sponsor != null && !string.IsNullOrEmpty(sponsor.Address1))
                        {
                            <a href="@sponsor.MapUrl" target="_blank" style="color:#9CA3AF;text-decoration:none">
                                @sponsor.Address1<br/>
                                @if (!string.IsNullOrEmpty(sponsor.Address2)) { @sponsor.Address2 <br/> }
                                @sponsor.City, @sponsor.State @sponsor.Zip
                            </a>
                        }
                    </td>
                    <td class="px-3 py-2 text-xs" style="color:#F5ECD7">
                        @foreach (var tp in st.TeamPlayers)
                        {
                            @tp.Player?.Name<br/>
                        }
                    </td>
                    <td class="px-3 py-2 text-center text-xs font-semibold" style="color:#9CA3AF">@st.PreSeasonDiv</td>
                    <td class="px-3 py-2 text-center text-xs font-semibold" style="color:#9CA3AF">@st.RegularSeasonDiv</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

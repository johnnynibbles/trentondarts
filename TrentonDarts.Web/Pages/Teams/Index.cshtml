@page "/teams"
@model TrentonDarts.Web.Pages.Teams.IndexModel
@{
    ViewData["Title"] = $"{Model.Season.Name} Teams";
}

<h2 class="text-2xl font-bold mb-5" style="color:#111827">@Model.Season.Name GTDL Teams</h2>

<div class="glass-card overflow-x-auto">
    <table class="w-full text-sm">
        <thead>
            <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Team</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Sponsor</th>
                <th class="px-3 py-2 text-center text-xs" style="color:#6B7280"></th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Address</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Captains</th>
                <th class="px-3 py-2 text-center text-xs font-semibold" style="color:#6B7280">Pre</th>
                <th class="px-3 py-2 text-center text-xs font-semibold" style="color:#6B7280">Regular</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.SeasonTeams.Any())
        {
            <tr><td colspan="7" class="px-3 py-6 text-center text-sm" style="color:#6B7280">Currently No Teams</td></tr>
        }
        else
        {
            @foreach (var st in Model.SeasonTeams.OrderBy(t => t.Team.Name))
            {
                var sponsor = st.Team.Sponsor;
                <tr style="border-bottom:1px solid #F3F4F6"
                    onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                    <td class="px-3 py-2 font-semibold">
                        <a href="/team/@st.Team.Id" style="color:#2563EB;text-decoration:none">@st.Team.Name</a>
                    </td>
                    <td class="px-3 py-2">
                        @if (sponsor != null)
                        {
                            if (!string.IsNullOrEmpty(sponsor.Url))
                            {
                                <a href="@sponsor.Url" target="_blank" style="color:#111827;text-decoration:none;font-weight:600">@sponsor.Name</a>
                            }
                            else
                            {
                                <strong style="color:#111827">@sponsor.Name</strong>
                            }
                            if (!string.IsNullOrEmpty(sponsor.Phone))
                            {
                                <div class="text-xs" style="color:#6B7280">@sponsor.Phone</div>
                            }
                        }
                    </td>
                    <td class="px-3 py-2 text-center">
                        @if (sponsor != null && !string.IsNullOrEmpty(sponsor.FacebookUrl))
                        {
                            <a href="@sponsor.FacebookUrl" target="_blank" style="color:#2563EB;font-size:1.1rem"><i class="fa-brands fa-facebook"></i></a>
                        }
                    </td>
                    <td class="px-3 py-2 text-xs" style="color:#6B7280">
                        @if (sponsor != null && !string.IsNullOrEmpty(sponsor.Address1))
                        {
                            <a href="@sponsor.MapUrl" target="_blank" style="color:#6B7280;text-decoration:none">
                                @sponsor.Address1<br/>
                                @if (!string.IsNullOrEmpty(sponsor.Address2)) { @sponsor.Address2 <br/> }
                                @sponsor.City, @sponsor.State @sponsor.Zip
                            </a>
                        }
                    </td>
                    <td class="px-3 py-2 text-xs" style="color:#374151">
                        @foreach (var tp in st.TeamPlayers)
                        {
                            @tp.Player?.Name<br/>
                        }
                    </td>
                    <td class="px-3 py-2 text-center text-xs font-semibold" style="color:#6B7280">@st.PreSeasonDiv</td>
                    <td class="px-3 py-2 text-center text-xs font-semibold" style="color:#6B7280">@st.RegularSeasonDiv</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

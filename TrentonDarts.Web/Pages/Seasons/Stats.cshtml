@page "/season/{seasonId:int}/stats"
@model TrentonDarts.Web.Pages.Seasons.StatsModel
@{
    ViewData["Title"] = $"Stats — {Model.Season.Name}";
}

<style media="print" type="text/css">@@page { size: landscape; }</style>

<h2 class="text-3xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">@Model.Season.Name — Stats</h2>

<div class="flex flex-wrap gap-3 mb-5">
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Season Part</label>
        <select id="seasonPart" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var opt in new[] { ("whole","Whole Season"), ("pre","Pre Season"), ("regular","Regular Season") })
            {
                if (opt.Item1 == Model.SeasonPart) { <option value="@opt.Item1" selected>@opt.Item2</option> }
                else { <option value="@opt.Item1">@opt.Item2</option> }
            }
        </select>
    </div>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Division</label>
        <select id="division" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            <option value="">All Divisions</option>
            @foreach (var kv in Model.Divisions)
            {
                if (kv.Key == Model.Division) { <option value="@kv.Key" selected>@kv.Value</option> }
                else { <option value="@kv.Key">@kv.Value</option> }
            }
        </select>
    </div>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Sort Teams By</label>
        <select id="leaderboard" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            <option value="">Select Sort</option>
            @foreach (var kv in TrentonDarts.Web.Pages.Seasons.StatsModel.Leaderboards)
            {
                if (kv.Key == Model.Leaderboard) { <option value="@kv.Key" selected>@kv.Value</option> }
                else { <option value="@kv.Key">@kv.Value</option> }
            }
        </select>
    </div>
</div>

<div class="glass-card overflow-x-auto season-stats">
    <table class="w-full text-xs whitespace-nowrap">
        <thead>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.08)">
                <th colspan="10" class="px-2 py-1"></th>
                <th colspan="4" class="px-2 py-1 text-center text-xs font-semibold uppercase tracking-wider" style="color:#C8962E;border-left:1px solid rgba(255,255,255,0.08)">Singles</th>
                <th colspan="4" class="px-2 py-1 text-center text-xs font-semibold uppercase tracking-wider" style="color:#C8962E;border-left:1px solid rgba(255,255,255,0.08)">Doubles</th>
                <th colspan="2" class="px-2 py-1 text-center text-xs font-semibold uppercase tracking-wider" style="color:#C8962E;border-left:1px solid rgba(255,255,255,0.08)">Triples</th>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.08)">
                <th colspan="4" class="px-2 py-1"></th>
                <th class="px-2 py-1 text-center" style="color:#9CA3AF">Overall</th>
                <th class="px-2 py-1 text-center" style="color:#9CA3AF">Singles</th>
                <th class="px-2 py-1 text-center" style="color:#9CA3AF">Doubles</th>
                <th class="px-2 py-1 text-center" style="color:#9CA3AF">T '01</th>
                <th class="px-2 py-1 text-center" style="color:#9CA3AF">Cricket</th>
                <th class="px-2 py-1 text-center" style="color:#9CA3AF">01</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#9CA3AF;border-left:1px solid rgba(255,255,255,0.06)">Cricket</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#9CA3AF">'01</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#9CA3AF;border-left:1px solid rgba(255,255,255,0.06)">Cricket</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#9CA3AF">501</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#9CA3AF;border-left:1px solid rgba(255,255,255,0.06)">'01</th>
            </tr>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
                <th class="px-2 py-2 text-left text-xs font-semibold" style="color:#F5ECD7">Team / Player</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280" title="Weeks Played">WP</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280" title="Games Played">GP</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Record</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#1A7A3C">W</th><th class="px-2 py-2 text-center text-xs" style="color:#C8101A">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#1A7A3C">W</th><th class="px-2 py-2 text-center text-xs" style="color:#C8101A">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#1A7A3C">W</th><th class="px-2 py-2 text-center text-xs" style="color:#C8101A">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#1A7A3C">W</th><th class="px-2 py-2 text-center text-xs" style="color:#C8101A">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#1A7A3C">W</th><th class="px-2 py-2 text-center text-xs" style="color:#C8101A">L</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.TeamStats.Any())
        {
            <tr><td colspan="20" class="px-3 py-4 text-center text-sm" style="color:#6B7280">Currently No Stats</td></tr>
        }
        else
        {
            @foreach (var t in Model.TeamStats)
            {
                <tr class="team-stat-row" style="border-bottom:1px solid rgba(255,255,255,0.06);background:rgba(200,150,46,0.06)">
                    <td colspan="3" class="px-2 py-2"><a href="/team/@t.TeamId?season=@Model.Season.Id" style="color:#C8962E;text-decoration:none;font-family:'Rajdhani',sans-serif;font-size:0.9rem">@t.TeamName</a></td>
                    <td class="px-2 py-2 text-center">@t.PointsWon - @t.PointsLost</td>
                    <td class="px-2 py-2 text-center">@(Math.Round(t.OverallWin * 100, 1))%</td>
                    <td class="px-2 py-2 text-center">@(Math.Round(t.SinglesWin * 100, 1))%</td>
                    <td class="px-2 py-2 text-center">@(Math.Round(t.DoublesWin * 100, 1))%</td>
                    <td class="px-2 py-2 text-center">@(Math.Round(t.Eight01Win * 100, 1))%</td>
                    <td class="px-2 py-2 text-center">@(Math.Round(t.CricketWin * 100, 1))%</td>
                    <td class="px-2 py-2 text-center">@(Math.Round(t.Oh1Win * 100, 1))%</td>
                    <td class="px-2 py-2 text-center" style="color:#1A7A3C">@t.GameCricket.Won</td><td class="px-2 py-2 text-center loss-column">@t.GameCricket.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#1A7A3C">@t.Game301.Won</td><td class="px-2 py-2 text-center loss-column">@t.Game301.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#1A7A3C">@t.GameDoubleCricket.Won</td><td class="px-2 py-2 text-center loss-column">@t.GameDoubleCricket.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#1A7A3C">@t.Game501.Won</td><td class="px-2 py-2 text-center loss-column">@t.Game501.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#1A7A3C">@t.Game801.Won</td><td class="px-2 py-2 text-center loss-column">@t.Game801.Lost</td>
                </tr>
                @foreach (var p in Model.PlayerStats.Where(ps => ps.TeamId == t.TeamId).OrderByDescending(ps => ps.OverallWin))
                {
                    <tr style="border-bottom:1px solid rgba(255,255,255,0.04)"
                        onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
                        <td class="px-2 py-1.5 pl-4"><a href="/player/@p.PlayerId?season=@Model.Season.Id" style="color:#F5ECD7;text-decoration:none">@p.PlayerName</a></td>
                        <td class="px-2 py-1.5 text-center" style="color:#9CA3AF">@p.WeeksPlayed</td>
                        <td class="px-2 py-1.5 text-center" style="color:#9CA3AF">@p.GamesPlayed</td>
                        <td class="px-2 py-1.5 text-center">@p.GamesWon - @p.GamesLost</td>
                        <td class="px-2 py-1.5 text-center">@(p.OverallWin > 0 ? $"{Math.Round(p.OverallWin * 100, 1)}%" : "–")</td>
                        <td class="px-2 py-1.5 text-center">@(p.SinglesWin > 0 ? $"{Math.Round(p.SinglesWin * 100, 1)}%" : "–")</td>
                        <td class="px-2 py-1.5 text-center">@(p.DoublesWin > 0 ? $"{Math.Round(p.DoublesWin * 100, 1)}%" : "–")</td>
                        <td class="px-2 py-1.5 text-center">@(p.Eight01Win > 0 ? $"{Math.Round(p.Eight01Win * 100, 1)}%" : "–")</td>
                        <td class="px-2 py-1.5 text-center">@(p.CricketWin > 0 ? $"{Math.Round(p.CricketWin * 100, 1)}%" : "–")</td>
                        <td class="px-2 py-1.5 text-center">@(p.Oh1Win > 0 ? $"{Math.Round(p.Oh1Win * 100, 1)}%" : "–")</td>
                        <td class="px-2 py-1.5 text-center" style="color:#1A7A3C">@p.GameCricket.Won</td><td class="px-2 py-1.5 text-center loss-column">@p.GameCricket.Lost</td>
                        <td class="px-2 py-1.5 text-center" style="color:#1A7A3C">@p.Game301.Won</td><td class="px-2 py-1.5 text-center loss-column">@p.Game301.Lost</td>
                        <td class="px-2 py-1.5 text-center" style="color:#1A7A3C">@p.GameDoubleCricket.Won</td><td class="px-2 py-1.5 text-center loss-column">@p.GameDoubleCricket.Lost</td>
                        <td class="px-2 py-1.5 text-center" style="color:#1A7A3C">@p.Game501.Won</td><td class="px-2 py-1.5 text-center loss-column">@p.Game501.Lost</td>
                        <td class="px-2 py-1.5 text-center" style="color:#1A7A3C">@p.Game801.Won</td><td class="px-2 py-1.5 text-center loss-column">@p.Game801.Lost</td>
                    </tr>
                }
            }
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
(function () {
    function navigate() {
        var q = '?seasonPart=' + encodeURIComponent(document.getElementById('seasonPart').value);
        var div = document.getElementById('division').value;
        var lb  = document.getElementById('leaderboard').value;
        if (div) q += '&division=' + encodeURIComponent(div);
        if (lb)  q += '&leaderboard=' + encodeURIComponent(lb);
        window.location = q;
    }
    ['seasonPart','division','leaderboard'].forEach(function(id) {
        document.getElementById(id).addEventListener('change', navigate);
    });
})();
</script>
}

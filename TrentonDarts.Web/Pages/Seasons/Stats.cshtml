@page "/season/{seasonId:int}/stats"
@model TrentonDarts.Web.Pages.Seasons.StatsModel
@{
    ViewData["Title"] = $"Stats — {Model.Season.Name}";
}

<style media="print" type="text/css">
    @@page { size: landscape; }
</style>

<div class="season-stats">
    <h3>Season @Model.Season.Name</h3>
    <div style="margin-right:15px;margin-left:15px;">
        <div class="row">
            <div class="col-xs-12 col-sm-3">
                <div class="form-group">
                    <label for="seasonPart">Season Part</label>
                    <select id="seasonPart" class="form-control">
                        @foreach (var opt in new[] { ("whole","Whole Season"), ("pre","Pre Season"), ("regular","Regular Season") })
                        {
                            if (opt.Item1 == Model.SeasonPart) { <option value="@opt.Item1" selected>@opt.Item2</option> }
                            else { <option value="@opt.Item1">@opt.Item2</option> }
                        }
                    </select>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3">
                <div class="form-group">
                    <label for="division">Division</label>
                    <select id="division" class="form-control">
                        <option value="">All Divisions</option>
                        @foreach (var kv in Model.Divisions)
                        {
                            if (kv.Key == Model.Division) { <option value="@kv.Key" selected>@kv.Value</option> }
                            else { <option value="@kv.Key">@kv.Value</option> }
                        }
                    </select>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3">
                <div class="form-group">
                    <label for="leaderboard">Sort Teams By</label>
                    <select id="leaderboard" class="form-control">
                        <option value="">Select Sort</option>
                        @foreach (var kv in TrentonDarts.Web.Pages.Seasons.StatsModel.Leaderboards)
                        {
                            if (kv.Key == Model.Leaderboard) { <option value="@kv.Key" selected>@kv.Value</option> }
                            else { <option value="@kv.Key">@kv.Value</option> }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-condensed table-striped table-hover">
            <thead>
                <tr>
                    <th colspan="10"></th>
                    <th colspan="4" style="text-align:center;">Singles</th>
                    <th colspan="4" style="text-align:center;">Doubles</th>
                    <th colspan="2" style="text-align:center;">Triples</th>
                </tr>
                <tr>
                    <th colspan="4"></th>
                    <th style="text-align:center;">Overall</th>
                    <th style="text-align:center;">Singles</th>
                    <th style="text-align:center;">Doubles</th>
                    <th style="text-align:center;">T '01</th>
                    <th style="text-align:center;">Cricket</th>
                    <th style="text-align:center;">01</th>
                    <th colspan="2" style="text-align:center;">Cricket</th>
                    <th colspan="2" style="text-align:center;">'01</th>
                    <th colspan="2" style="text-align:center;">Cricket</th>
                    <th colspan="2" style="text-align:center;">501</th>
                    <th colspan="2" style="text-align:center;">'01</th>
                </tr>
                <tr>
                    <th>Team Name</th><th title="Weeks Played">WP</th><th title="Games Played">GP</th>
                    <th style="text-align:center;">Record</th>
                    <th style="text-align:center;">Win %</th><th style="text-align:center;">Win %</th>
                    <th style="text-align:center;">Win %</th><th style="text-align:center;">Win %</th>
                    <th style="text-align:center;">Win %</th><th style="text-align:center;">Win %</th>
                    <th style="text-align:center;">W</th><th style="text-align:center;">L</th>
                    <th style="text-align:center;">W</th><th style="text-align:center;">L</th>
                    <th style="text-align:center;">W</th><th style="text-align:center;">L</th>
                    <th style="text-align:center;">W</th><th style="text-align:center;">L</th>
                    <th style="text-align:center;">W</th><th style="text-align:center;">L</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.TeamStats.Any())
            {
                <tr class="warning"><td colspan="20">Currently No Stats</td></tr>
            }
            else
            {
                @foreach (var t in Model.TeamStats)
                {
                    <tr class="team-stat-row info">
                        <td colspan="3"><a href="/team/@t.TeamId?season=@Model.Season.Id">@t.TeamName</a></td>
                        <td style="text-align:center;">@t.PointsWon - @t.PointsLost</td>
                        <td style="text-align:center;">@(Math.Round(t.OverallWin * 100, 1)) %</td>
                        <td style="text-align:center;">@(Math.Round(t.SinglesWin * 100, 1)) %</td>
                        <td style="text-align:center;">@(Math.Round(t.DoublesWin * 100, 1)) %</td>
                        <td style="text-align:center;">@(Math.Round(t.Eight01Win * 100, 1)) %</td>
                        <td style="text-align:center;">@(Math.Round(t.CricketWin * 100, 1)) %</td>
                        <td style="text-align:center;">@(Math.Round(t.Oh1Win * 100, 1)) %</td>
                        <td style="text-align:center;">@t.GameCricket.Won</td><td style="text-align:center;" class="loss-column">@t.GameCricket.Lost</td>
                        <td style="text-align:center;">@t.Game301.Won</td><td style="text-align:center;" class="loss-column">@t.Game301.Lost</td>
                        <td style="text-align:center;">@t.GameDoubleCricket.Won</td><td style="text-align:center;" class="loss-column">@t.GameDoubleCricket.Lost</td>
                        <td style="text-align:center;">@t.Game501.Won</td><td style="text-align:center;" class="loss-column">@t.Game501.Lost</td>
                        <td style="text-align:center;">@t.Game801.Won</td><td style="text-align:center;" class="loss-column">@t.Game801.Lost</td>
                    </tr>
                    @foreach (var p in Model.PlayerStats.Where(ps => ps.TeamId == t.TeamId).OrderByDescending(ps => ps.OverallWin))
                    {
                        <tr>
                            <td><a href="/player/@p.PlayerId?season=@Model.Season.Id">@p.PlayerName</a></td>
                            <td style="text-align:center;">@p.WeeksPlayed</td>
                            <td style="text-align:center;">@p.GamesPlayed</td>
                            <td style="text-align:center;">@p.GamesWon - @p.GamesLost</td>
                            <td style="text-align:center;">@(p.OverallWin > 0 ? $"{Math.Round(p.OverallWin * 100, 1)} %" : "-")</td>
                            <td style="text-align:center;">@(p.SinglesWin > 0 ? $"{Math.Round(p.SinglesWin * 100, 1)} %" : "-")</td>
                            <td style="text-align:center;">@(p.DoublesWin > 0 ? $"{Math.Round(p.DoublesWin * 100, 1)} %" : "-")</td>
                            <td style="text-align:center;">@(p.Eight01Win > 0 ? $"{Math.Round(p.Eight01Win * 100, 1)} %" : "-")</td>
                            <td style="text-align:center;">@(p.CricketWin > 0 ? $"{Math.Round(p.CricketWin * 100, 1)} %" : "-")</td>
                            <td style="text-align:center;">@(p.Oh1Win > 0 ? $"{Math.Round(p.Oh1Win * 100, 1)} %" : "-")</td>
                            <td style="text-align:center;">@p.GameCricket.Won</td><td style="text-align:center;" class="loss-column">@p.GameCricket.Lost</td>
                            <td style="text-align:center;">@p.Game301.Won</td><td style="text-align:center;" class="loss-column">@p.Game301.Lost</td>
                            <td style="text-align:center;">@p.GameDoubleCricket.Won</td><td style="text-align:center;" class="loss-column">@p.GameDoubleCricket.Lost</td>
                            <td style="text-align:center;">@p.Game501.Won</td><td style="text-align:center;" class="loss-column">@p.Game501.Lost</td>
                            <td style="text-align:center;">@p.Game801.Won</td><td style="text-align:center;" class="loss-column">@p.Game801.Lost</td>
                        </tr>
                    }
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function($){
            $(document).ready(function() {
                $("#seasonPart, #division, #leaderboard").change(function() {
                    var q = '?seasonPart=' + encodeURIComponent($("#seasonPart").val());
                    var div = $("#division").val();
                    var lb = $("#leaderboard").val();
                    if (div) q += '&division=' + encodeURIComponent(div);
                    if (lb) q += '&leaderboard=' + encodeURIComponent(lb);
                    window.location = q;
                });
            });
        })(jQuery);
    </script>
}

@page "/season/{seasonId:int}/schedule"
@model TrentonDarts.Web.Pages.Seasons.ScheduleModel
@{
    ViewData["Title"] = $"Schedule — {Model.Season.Name}";
}

<h2 class="text-2xl font-bold mb-6" style="color:#111827">@Model.Season.Name — Schedule</h2>

@{
    void RenderScheduleSection(IEnumerable<TrentonDarts.Web.Services.DivisionSchedule> schedules)
    {
        foreach (var schedule in schedules)
        {
            <div class="mb-8">
                <div class="text-center py-2 px-4 rounded mb-3 text-sm font-bold uppercase tracking-widest"
                     style="background:#EFF6FF;border:1px solid #BFDBFE;color:#2563EB">
                    Division @schedule.Name
                </div>
                <div class="flex flex-wrap gap-3">
                    @foreach (var week in schedule.Weeks)
                    {
                        <div class="glass-card overflow-hidden flex-shrink-0" style="width:calc(50% - 0.375rem);min-width:220px">
                            <div style="padding:6px 12px;text-align:center;font-size:11px;font-weight:600;border-bottom:1px solid #E5E7EB;background:#F9FAFB;color:#6B7280">
                                @week.Date.ToString("MM-dd-yyyy")
                            </div>
                            <div class="p-2">
                                @if (!week.Matches.Any())
                                {
                                    <div class="py-2 text-center text-sm" style="color:#6B7280"><strong>No Matches</strong></div>
                                }
                                @foreach (var m in week.Matches)
                                {
                                    var noScore = m.AwayScore == 0 && m.HomeScore == 0;
                                    var matchUrl = Model.IsBoardMember
                                        ? $"/season/{Model.Season.Id}/match/{m.MatchId}/edit"
                                        : $"/season/{Model.Season.Id}/match/{m.MatchId}";
                                    var awayWin = !noScore && m.AwayScore > m.HomeScore;
                                    var homeWin = !noScore && m.HomeScore > m.AwayScore;
                                    <a href="@matchUrl" style="text-decoration:none;display:block">
                                        <div class="rounded overflow-hidden mb-1.5"
                                             style="border:1px solid #E5E7EB;transition:border-color 0.13s"
                                             onmouseover="this.style.borderColor='#2563EB'" onmouseout="this.style.borderColor='#E5E7EB'">
                                            <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 10px;font-size:13px;@(noScore ? "" : awayWin ? "font-weight:600;" : "color:#9CA3AF;")">
                                                <span style="flex:1">@m.AwayTeamName</span>
                                                <span style="font-variant-numeric:tabular-nums;font-weight:700;font-size:15px;margin-left:8px;@(noScore ? "color:#9CA3AF" : awayWin ? "color:#16A34A" : "color:#DC2626")">
                                                    @(noScore ? "–" : m.AwayScore.ToString())
                                                </span>
                                            </div>
                                            <div style="display:flex;align-items:center;justify-content:space-between;padding:6px 10px;font-size:13px;border-top:1px solid #F3F4F6;@(noScore ? "" : homeWin ? "font-weight:600;" : "color:#9CA3AF;")">
                                                <span style="flex:1">
                                                    @m.HomeTeamName
                                                    @if (!m.HasScorecard && !noScore) { <i title="Scorecard not entered" class="fa-solid fa-bolt text-xs ml-1" style="color:#DC2626"></i> }
                                                </span>
                                                <span style="font-variant-numeric:tabular-nums;font-weight:700;font-size:15px;margin-left:8px;@(noScore ? "color:#9CA3AF" : homeWin ? "color:#16A34A" : "color:#DC2626")">
                                                    @(noScore ? "–" : m.HomeScore.ToString())
                                                </span>
                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>
                            <div style="padding:6px 12px;font-size:11px;border-top:1px solid #E5E7EB;color:#6B7280">
                                <strong style="color:#9CA3AF">Bye:</strong>
                                @(week.ByeTeamNames.Any() ? string.Join(", ", week.ByeTeamNames) : "None")
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@{
    if (Model.PreSchedules.Any())
    {
        <h3 class="text-xl font-bold mb-4" style="color:#111827">Pre Season</h3>
        RenderScheduleSection(Model.PreSchedules);
    }
}

<h3 class="text-xl font-bold mt-6 mb-4" style="color:#111827">Regular Season</h3>
@{
    if (Model.RegularSchedules.Any())
    {
        RenderScheduleSection(Model.RegularSchedules);
    }
    else
    {
        <div class="glass-card p-6 text-center" style="color:#6B7280">No Schedule</div>
    }
}

<style>
@@media (max-width: 550px) {
    .flex.flex-wrap > .glass-card { width: 100% !important; }
}
</style>

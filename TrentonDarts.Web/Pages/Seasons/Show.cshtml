@page "/season/{id:int}"
@model TrentonDarts.Web.Pages.Seasons.ShowModel
@{
    ViewData["Title"] = Model.Season.Name;
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">@Model.Season.Name</h2>

@* Week navigation *@
<div class="flex items-center gap-2 mb-6">
    @if (Model.PreviousWeekDate.HasValue)
    {
        <a href="/season/@Model.Season.Id?week=@Model.PreviousWeekDate.Value.ToString("yyyy-MM-dd")"
           class="px-3 py-1.5 text-sm rounded transition-colors"
           style="background:transparent;border:1px solid #E5E7EB;color:#374151;text-decoration:none">
            &laquo; Previous
        </a>
    }
    else
    {
        <span class="px-3 py-1.5 text-sm rounded" style="background:#F3F4F6;border:1px solid #E5E7EB;color:#9CA3AF">&laquo; Previous</span>
    }
    @if (Model.NextWeekDate.HasValue)
    {
        <a href="/season/@Model.Season.Id?week=@Model.NextWeekDate.Value.ToString("yyyy-MM-dd")"
           class="px-3 py-1.5 text-sm rounded transition-colors"
           style="background:transparent;border:1px solid #E5E7EB;color:#374151;text-decoration:none">
            Next &raquo;
        </a>
    }
    else
    {
        <span class="px-3 py-1.5 text-sm rounded" style="background:#F3F4F6;border:1px solid #E5E7EB;color:#9CA3AF">Next &raquo;</span>
    }
    @if (Model.ResultWeekDate.HasValue)
    {
        <span class="text-sm text-center flex-1" style="color:#6B7280">
            @if (Model.CurrentWeekNumber > 0 && Model.TotalWeeks > 0)
            {
                <span class="font-semibold" style="color:#111827">Week @Model.CurrentWeekNumber of @Model.TotalWeeks</span>
                <span class="mx-1" style="color:#9CA3AF">—</span>
            }
            @Model.ResultWeekDate.Value.ToString("MMMM d, yyyy")
        </span>
    }
</div>

@* Weekly results *@
@if (Model.DivSchedules.Any())
{
    foreach (var div in Model.DivSchedules)
    {
        foreach (var week in div.Weeks)
        {
            if (week.Matches.Any())
            {
                <h4 class="text-sm font-semibold mb-2 mt-4" style="color:#2563EB;text-transform:uppercase;letter-spacing:0.05em">
                    Results — @week.Date.ToString("MMMM d, yyyy")
                </h4>
                <div class="glass-card overflow-hidden mb-6">
                    <table class="w-full" style="font-size:13px;border-collapse:collapse">
                        <thead>
                            <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                                <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Division</th>
                                <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Away</th>
                                <th style="padding:7px 12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Score</th>
                                <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Home</th>
                                <th style="padding:7px 12px"></th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var m in week.Matches)
                        {
                            <tr class="clickable-row"
                                onclick="window.location='/season/@Model.Season.Id/match/@m.MatchId'"
                                style="border-bottom:1px solid #F3F4F6"
                                onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                                <td style="padding:9px 12px;color:#6B7280">@m.Division</td>
                                <td style="padding:9px 12px;color:#111827">@m.AwayTeamName</td>
                                <td style="padding:9px 12px;text-align:center;font-weight:700;font-variant-numeric:tabular-nums;color:#2563EB">
                                    @(m.HasScorecard || m.AwayScore > 0 || m.HomeScore > 0 ? $"{m.AwayScore} – {m.HomeScore}" : "vs")
                                </td>
                                <td style="padding:9px 12px;font-weight:600;color:#111827">@m.HomeTeamName</td>
                                <td style="padding:9px 12px;text-align:right">
                                    @if (Model.IsBoardMember)
                                    {
                                        <a href="/season/@Model.Season.Id/match/@m.MatchId/edit"
                                           style="font-size:12px;padding:2px 8px;border-radius:4px;background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none"
                                           onclick="event.stopPropagation()">Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (week.ByeTeamNames.Any())
                {
                    <p class="text-sm mb-4" style="color:#6B7280"><strong style="color:#374151">Byes:</strong> @string.Join(", ", week.ByeTeamNames)</p>
                }
            }
        }
    }
}

@* Division standings *@
<h3 class="text-xl font-bold mt-6 mb-4" style="color:#111827">
    Standings — @(Model.SeasonPart == "regular" ? "Regular Season" : "Pre-Season")
</h3>
<div class="grid gap-4 sm:grid-cols-2">
@foreach (var div in Model.DivStandings)
{
    <div class="glass-card overflow-hidden">
        <div style="padding:10px 16px;border-bottom:1px solid #E5E7EB;background:#F9FAFB">
            <span style="font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.04em;color:#2563EB">Division @div.Name</span>
        </div>
        <table class="w-full" style="font-size:13px;border-collapse:collapse">
            <thead>
                <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                    <th style="padding:6px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Team</th>
                    @if (Model.Season.IsUsingMatchPoints) { <th style="padding:6px 8px;text-align:center;font-size:10px;font-weight:700;color:#6B7280">MP</th> }
                    <th style="padding:6px 8px;text-align:center;font-size:10px;font-weight:700;color:#6B7280">W</th>
                    <th style="padding:6px 8px;text-align:center;font-size:10px;font-weight:700;color:#6B7280">L</th>
                    <th style="padding:6px 8px;text-align:center;font-size:10px;font-weight:700;color:#6B7280">%</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var s in div.Standings)
            {
                <tr style="border-bottom:1px solid #F3F4F6"
                    onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                    <td style="padding:8px 12px"><a href="/team/@s.TeamId" style="color:#2563EB;text-decoration:none;font-weight:500">@s.Name</a></td>
                    @if (Model.Season.IsUsingMatchPoints) { <td style="padding:8px;text-align:center;color:#111827">@s.MatchPoints</td> }
                    <td style="padding:8px;text-align:center;font-weight:600;color:#16A34A">@s.WonPoints</td>
                    <td style="padding:8px;text-align:center;font-weight:600;color:#DC2626">@s.LossPoints</td>
                    <td style="padding:8px;text-align:center;font-size:12px;color:#6B7280">@s.Percentage.ToString("P1")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
</div>

@* Next week schedule *@
@if (Model.NextWeekSchedules.Any())
{
    <h3 class="text-xl font-bold mt-6 mb-3" style="color:#111827">Upcoming</h3>
    @foreach (var div in Model.NextWeekSchedules)
    {
        foreach (var week in div.Weeks)
        {
            if (week.Matches.Any())
            {
                <h4 class="text-sm font-semibold mb-2" style="color:#2563EB">Week of @week.Date.ToString("MMMM d, yyyy")</h4>
                <div class="glass-card overflow-hidden mb-4">
                    <table class="w-full" style="font-size:13px;border-collapse:collapse">
                        <thead>
                            <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                                <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;color:#6B7280">Division</th>
                                <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;color:#6B7280">Away</th>
                                <th style="padding:7px 12px;text-align:center;font-size:10px;font-weight:700;color:#6B7280">vs</th>
                                <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;color:#6B7280">Home</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var m in week.Matches)
                        {
                            <tr style="border-bottom:1px solid #F3F4F6">
                                <td style="padding:9px 12px;color:#6B7280">@m.Division</td>
                                <td style="padding:9px 12px;color:#111827">@m.AwayTeamName</td>
                                <td style="padding:9px 12px;text-align:center;color:#9CA3AF">@@</td>
                                <td style="padding:9px 12px;font-weight:600;color:#111827">@m.HomeTeamName</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            @if (week.ByeTeamNames.Any())
            {
                <p class="text-sm mb-3" style="color:#6B7280"><strong style="color:#374151">Byes:</strong> @string.Join(", ", week.ByeTeamNames)</p>
            }
        }
    }
}

@* Awards for the week *@
@if (Model.Awards.Any())
{
    <h3 class="text-xl font-bold mt-6 mb-3" style="color:#111827">
        Awards @(Model.ViewAllAwards ? "(All)" : "")
    </h3>
    <div class="glass-card overflow-hidden mb-4">
        <table class="w-full" style="font-size:13px;border-collapse:collapse">
            <thead>
                <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                    <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Player</th>
                    <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Team</th>
                    <th style="padding:7px 12px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Award</th>
                    <th style="padding:7px 12px;text-align:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#6B7280">Value</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var a in Model.Awards)
            {
                <tr style="border-bottom:1px solid #F3F4F6"
                    onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                    <td style="padding:9px 12px;color:#111827">@a.PlayerName</td>
                    <td style="padding:9px 12px;color:#6B7280">@a.TeamName</td>
                    <td style="padding:9px 12px;color:#2563EB;font-weight:500">@a.AwardType</td>
                    <td style="padding:9px 12px;text-align:center;font-weight:700;font-size:1rem;font-variant-numeric:tabular-nums;color:#111827">
                        @(a.Value > 0 ? a.Value.ToString() : "")
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.ViewAllAwards)
    {
        <a href="/season/@Model.Season.Id?allAwards=true" class="text-sm" style="color:#2563EB;text-decoration:none">View all awards &rarr;</a>
    }
}

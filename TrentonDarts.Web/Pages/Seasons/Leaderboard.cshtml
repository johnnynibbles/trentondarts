@page "/season/{seasonId:int}/leaderboard"
@model TrentonDarts.Web.Pages.Seasons.LeaderboardModel
@{
    ViewData["Title"] = $"Leaderboard — {Model.Season.Name}";
    int position = 1;
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">@Model.Season.Name — Leaderboard</h2>

<div class="flex flex-wrap gap-3 mb-5">
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Season Part</label>
        <select id="seasonPart" class="rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB">
            @foreach (var opt in new[] { ("whole","Whole Season"), ("pre","Pre Season"), ("regular","Regular Season") })
            {
                if (opt.Item1 == Model.SeasonPart) { <option value="@opt.Item1" selected>@opt.Item2</option> }
                else { <option value="@opt.Item1">@opt.Item2</option> }
            }
        </select>
    </div>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Division</label>
        <select id="division" class="rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB">
            <option value="">All Divisions</option>
            @foreach (var kv in Model.Divisions)
            {
                if (kv.Key == Model.Division) { <option value="@kv.Key" selected>@kv.Value</option> }
                else { <option value="@kv.Key">@kv.Value</option> }
            }
        </select>
    </div>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Leaderboard</label>
        <select id="leaderboard" class="rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB">
            <option value="">Select</option>
            @foreach (var kv in TrentonDarts.Web.Pages.Seasons.LeaderboardModel.Leaderboards)
            {
                if (kv.Key == Model.Leaderboard) { <option value="@kv.Key" selected>@kv.Value</option> }
                else { <option value="@kv.Key">@kv.Value</option> }
            }
        </select>
    </div>
</div>

<div class="glass-card overflow-x-auto season-leaderboard">
    <table class="w-full text-xs whitespace-nowrap">
        <thead>
            <tr style="border-bottom:1px solid #E5E7EB">
                <th colspan="11" class="px-2 py-1"></th>
                <th colspan="4" class="px-2 py-1 text-center text-xs font-semibold uppercase tracking-wider" style="color:#2563EB;border-left:1px solid #E5E7EB">Singles</th>
                <th colspan="4" class="px-2 py-1 text-center text-xs font-semibold uppercase tracking-wider" style="color:#2563EB;border-left:1px solid #E5E7EB">Doubles</th>
                <th colspan="2" class="px-2 py-1 text-center text-xs font-semibold uppercase tracking-wider" style="color:#2563EB;border-left:1px solid #E5E7EB">Triples</th>
            </tr>
            <tr style="border-bottom:1px solid #E5E7EB">
                <th colspan="5" class="px-2 py-1"></th>
                <th class="px-2 py-1 text-center" style="color:#6B7280">Overall</th>
                <th class="px-2 py-1 text-center" style="color:#6B7280">Singles</th>
                <th class="px-2 py-1 text-center" style="color:#6B7280">Doubles</th>
                <th class="px-2 py-1 text-center" style="color:#6B7280">T '01</th>
                <th class="px-2 py-1 text-center" style="color:#6B7280">Cricket</th>
                <th class="px-2 py-1 text-center" style="color:#6B7280">01</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#6B7280;border-left:1px solid #E5E7EB">Cricket</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#6B7280">'01</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#6B7280;border-left:1px solid #E5E7EB">Cricket</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#6B7280">501</th>
                <th colspan="2" class="px-2 py-1 text-center" style="color:#6B7280;border-left:1px solid #E5E7EB">'01</th>
            </tr>
            <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">#</th>
                <th class="px-2 py-2 text-left text-xs font-semibold" style="color:#374151">Player</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280" title="Weeks Played">WP</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280" title="Games Played">GP</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Record</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#6B7280">Win%</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#16A34A">W</th><th class="px-2 py-2 text-center text-xs" style="color:#DC2626">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#16A34A">W</th><th class="px-2 py-2 text-center text-xs" style="color:#DC2626">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#16A34A">W</th><th class="px-2 py-2 text-center text-xs" style="color:#DC2626">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#16A34A">W</th><th class="px-2 py-2 text-center text-xs" style="color:#DC2626">L</th>
                <th class="px-2 py-2 text-center text-xs" style="color:#16A34A">W</th><th class="px-2 py-2 text-center text-xs" style="color:#DC2626">L</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.PlayerStats.Any())
        {
            <tr><td colspan="21" class="px-3 py-4 text-center text-sm" style="color:#6B7280">Currently No Stats</td></tr>
        }
        else
        {
            @foreach (var p in Model.PlayerStats)
            {
                <tr style="border-bottom:1px solid #F3F4F6"
                    onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                    <td class="px-2 py-2 text-center font-bold" style="font-size:1rem;color:#2563EB">@(position++)</td>
                    <td class="px-2 py-2"><a href="/player/@p.PlayerId" style="color:#374151;text-decoration:none">@p.PlayerName</a></td>
                    <td class="px-2 py-2 text-center" style="color:#6B7280">@p.WeeksPlayed</td>
                    <td class="px-2 py-2 text-center" style="color:#6B7280">@p.GamesPlayed</td>
                    <td class="px-2 py-2 text-center">@p.GamesWon - @p.GamesLost</td>
                    <td class="px-2 py-2 text-center">@(p.OverallWin > 0 ? $"{Math.Round(p.OverallWin * 100, 1)}%" : "–")</td>
                    <td class="px-2 py-2 text-center">@(p.SinglesWin > 0 ? $"{Math.Round(p.SinglesWin * 100, 1)}%" : "–")</td>
                    <td class="px-2 py-2 text-center">@(p.DoublesWin > 0 ? $"{Math.Round(p.DoublesWin * 100, 1)}%" : "–")</td>
                    <td class="px-2 py-2 text-center">@(p.Eight01Win > 0 ? $"{Math.Round(p.Eight01Win * 100, 1)}%" : "–")</td>
                    <td class="px-2 py-2 text-center">@(p.CricketWin > 0 ? $"{Math.Round(p.CricketWin * 100, 1)}%" : "–")</td>
                    <td class="px-2 py-2 text-center">@(p.Oh1Win > 0 ? $"{Math.Round(p.Oh1Win * 100, 1)}%" : "–")</td>
                    <td class="px-2 py-2 text-center" style="color:#16A34A">@p.GameCricket.Won</td><td class="px-2 py-2 text-center loss-column">@p.GameCricket.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#16A34A">@p.Game301.Won</td><td class="px-2 py-2 text-center loss-column">@p.Game301.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#16A34A">@p.GameDoubleCricket.Won</td><td class="px-2 py-2 text-center loss-column">@p.GameDoubleCricket.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#16A34A">@p.Game501.Won</td><td class="px-2 py-2 text-center loss-column">@p.Game501.Lost</td>
                    <td class="px-2 py-2 text-center" style="color:#16A34A">@p.Game801.Won</td><td class="px-2 py-2 text-center loss-column">@p.Game801.Lost</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
(function () {
    function navigate() {
        var q = '?seasonPart=' + encodeURIComponent(document.getElementById('seasonPart').value);
        var div = document.getElementById('division').value;
        var lb  = document.getElementById('leaderboard').value;
        if (div) q += '&division=' + encodeURIComponent(div);
        if (lb)  q += '&leaderboard=' + encodeURIComponent(lb);
        window.location = q;
    }
    ['seasonPart','division','leaderboard'].forEach(function(id) {
        document.getElementById(id).addEventListener('change', navigate);
    });
})();
</script>
}

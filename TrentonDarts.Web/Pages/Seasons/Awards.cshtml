@page "/season/{seasonId:int}/awards"
@model TrentonDarts.Web.Pages.Seasons.AwardsModel
@{
    ViewData["Title"] = $"Awards — {Model.Season.Name}";
}

<style media="print" type="text/css">
    @@page { size: landscape; }
</style>

<div class="season-stats">
    <h3>Season @Model.Season.Name</h3>
    <div style="margin-right:15px;margin-left:15px;">
        <div class="row">
            <div class="col-xs-12 col-sm-3">
                <div class="form-group">
                    <label for="seasonPart">Season Part</label>
                    <select id="seasonPart" class="form-control">
                        @foreach (var opt in new[] { ("whole","Whole Season"), ("pre","Pre Season"), ("regular","Regular Season") })
                        {
                            if (opt.Item1 == Model.SeasonPart) { <option value="@opt.Item1" selected>@opt.Item2</option> }
                            else { <option value="@opt.Item1">@opt.Item2</option> }
                        }
                    </select>
                </div>
            </div>
            <div class="col-xs-12 col-sm-3">
                <div class="form-group">
                    <label for="division">Division</label>
                    <select id="division" class="form-control">
                        <option value="">All Divisions</option>
                        @foreach (var kv in Model.Divisions)
                        {
                            @if (kv.Key == Model.Division) { <option value="@kv.Key" selected>@kv.Value</option> }
                            else { <option value="@kv.Key">@kv.Value</option> }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-condensed table-striped table-hover">
            <thead>
                <tr>
                    <th>Player Name</th>
                    <th>Team Name</th>
                    <th style="text-align:center;">Season Part</th>
                    <th style="text-align:center;">Division</th>
                    <th style="text-align:center;">Date</th>
                    <th style="text-align:center;">Award</th>
                    <th style="text-align:center;">Value</th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Awards.Any())
            {
                <tr class="warning"><td colspan="7">Currently No Awards</td></tr>
            }
            else
            {
                @foreach (var a in Model.Awards)
                {
                    <tr>
                        <td><a href="/player/@a.PlayerId?season=@Model.Season.Id">@a.PlayerName</a></td>
                        <td><a href="/team/@a.TeamId?season=@Model.Season.Id">@a.TeamName</a></td>
                        <td style="text-align:center;">@(a.SeasonPart == "pre" ? "Pre" : "Regular")</td>
                        <td style="text-align:center;">@a.Division</td>
                        <td style="text-align:center;">@a.Date.ToString("MM-dd-yyyy")</td>
                        <td style="text-align:center;">@a.AwardType</td>
                        <td style="text-align:center;">@(a.Value > 0 ? a.Value.ToString() : "")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function($){
            $(document).ready(function() {
                $("#seasonPart, #division").change(function() {
                    var q = '?seasonPart=' + encodeURIComponent($("#seasonPart").val());
                    var div = $("#division").val();
                    if (div) q += '&division=' + encodeURIComponent(div);
                    window.location = q;
                });
            });
        })(jQuery);
    </script>
}

@model TrentonDarts.Web.Pages.Manage.Sponsors.SponsorInput

<div class="form-group">
    <label class="col-sm-2 control-label">Name *</label>
    <div class="col-sm-4">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Type *</label>
    <div class="col-sm-3">
        <select asp-for="Type" class="form-control">
            @foreach (var kv in TrentonDarts.Web.Data.Entities.Sponsor.SponsorTypes)
            {
                if (kv.Key == Model?.Type) { <option value="@kv.Key" selected>@kv.Value</option> }
                else { <option value="@kv.Key">@kv.Value</option> }
            }
        </select>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Contact Name</label>
    <div class="col-sm-4">
        <input asp-for="ContactName" class="form-control" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Address</label>
    <div class="col-sm-6">
        <input asp-for="Address1" class="form-control" placeholder="Address Line 1" />
    </div>
</div>
<div class="form-group">
    <div class="col-sm-offset-2 col-sm-6">
        <input asp-for="Address2" class="form-control" placeholder="Address Line 2" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">City</label>
    <div class="col-sm-4"><input asp-for="City" class="form-control" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">State</label>
    <div class="col-sm-2"><input asp-for="State" class="form-control" maxlength="2" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Zip</label>
    <div class="col-sm-2"><input asp-for="Zip" class="form-control" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Phone</label>
    <div class="col-sm-4"><input asp-for="Phone" class="form-control" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Website URL</label>
    <div class="col-sm-6"><input asp-for="Url" class="form-control" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Facebook URL</label>
    <div class="col-sm-6"><input asp-for="FacebookUrl" class="form-control" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Map URL</label>
    <div class="col-sm-6"><input asp-for="MapUrl" class="form-control" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Email</label>
    <div class="col-sm-4"><input asp-for="Email" class="form-control" type="email" /></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Description</label>
    <div class="col-sm-6"><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Comments</label>
    <div class="col-sm-6"><textarea asp-for="Comments" class="form-control" rows="2"></textarea></div>
</div>

@page "/Manage/{leagueId:int}/pageparts/create"
@model TrentonDarts.Web.Pages.Manage.PageParts.CreateModel
@{
    ViewData["Title"] = "Add Page Part";
    Layout = "_ManageLayout";
}
@section Scripts {
    <script src="/dist/tiptap-editor.js"></script>
    <script>
        initTipTapEditor('tiptap-editor', 'Input_Html', '');
    </script>
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">Add Page Part</h2>
<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/pageparts" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Back</a>
</div>

<form method="post" class="max-w-xl">
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Name *</label>
        <input asp-for="Input.Name" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" />
        <span asp-validation-for="Input.Name" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Description</label>
        <input asp-for="Input.Description" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">HTML</label>
        <input type="hidden" asp-for="Input.Html" id="Input_Html" />
        <div id="tiptap-editor" style="border-radius:0.5rem;overflow:hidden"></div>
    </div>
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#2563EB;color:#fff;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/pageparts" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Cancel</a>
    </div>
</form>

@page "/Manage/{leagueId:int}/pageparts"
@model TrentonDarts.Web.Pages.Manage.PageParts.IndexModel
@{
    ViewData["Title"] = "Page Parts";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">Page Parts</h2>
<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/pageparts/create" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#2563EB;color:#fff;text-decoration:none">Add Page Part</a>
</div>

<div class="glass-card overflow-x-auto">
<table class="w-full text-sm">
    <thead>
        <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Name</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Description</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Parts)
    {
        <tr style="border-bottom:1px solid #F3F4F6"
            onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
            <td class="px-3 py-2" style="color:#111827">@p.Name</td>
            <td class="px-3 py-2" style="color:#6B7280">@p.Description</td>
            <td class="px-3 py-2">
                <a href="/Manage/@Model.LeagueId/pageparts/@p.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Edit</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

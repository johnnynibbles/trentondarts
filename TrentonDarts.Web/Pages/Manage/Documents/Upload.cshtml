@page "/Manage/{leagueId:int}/documents/upload"
@model TrentonDarts.Web.Pages.Manage.Documents.UploadModel
@{
    ViewData["Title"] = "Upload Document";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Upload Document</h2>
<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/documents" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
</div>

<form method="post" enctype="multipart/form-data" class="max-w-xl">
    <div asp-validation-summary="All" class="mb-4 p-3 rounded-lg text-sm" style="background:rgba(200,16,26,0.15);color:#fca5a5;border:1px solid rgba(200,16,26,0.3)"></div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Title *</label>
        <input asp-for="Title" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" placeholder="e.g. League Rules" />
        <span asp-validation-for="Title" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">URL Slug <span style="font-weight:400;text-transform:none">(optional)</span></label>
        <input asp-for="Slug" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" placeholder="e.g. league-rules" />
        <p class="text-xs mt-1" style="color:#6B7280">Lowercase letters, numbers, hyphens. Enables URL: /file/league-rules</p>
        <span asp-validation-for="Slug" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">File *</label>
        <input asp-for="UploadFile" type="file" class="text-sm" style="color:#F5ECD7" accept=".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif" />
        <span asp-validation-for="UploadFile" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Upload</button>
        <a href="/Manage/@Model.LeagueId/documents" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Cancel</a>
    </div>
</form>

@page "/Manage/{leagueId:int}"
@model TrentonDarts.Web.Pages.Manage.IndexModel
@{
    ViewData["Title"] = "Manage";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-5" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">League Management</h2>
<div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-w-lg">
    <a href="/Manage/@Model.LeagueId/players" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Players</a>
    <a href="/Manage/@Model.LeagueId/teams" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Teams</a>
    <a href="/Manage/@Model.LeagueId/sponsors" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Sponsors</a>
    <a href="/Manage/@Model.LeagueId/boardmembers" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Board Members</a>
    <a href="/Manage/@Model.LeagueId/matchtypes" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Match Types</a>
    <a href="/Manage/@Model.LeagueId/dartevents" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Dart Events</a>
    <a href="/Manage/@Model.LeagueId/pageparts" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Page Parts</a>
    <a href="/Manage/@Model.LeagueId/documents" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Documents</a>
    <a href="/Manage/@Model.LeagueId/navigation" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Navigation</a>
    <a href="/Manage/@Model.LeagueId/seasons" class="glass-card p-4 text-sm font-medium text-center" style="color:#F5ECD7;text-decoration:none;display:block" onmouseover="this.style.background='rgba(255,255,255,0.08)'" onmouseout="this.style.background=''">Seasons</a>
</div>

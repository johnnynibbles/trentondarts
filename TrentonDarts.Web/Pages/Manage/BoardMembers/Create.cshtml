@page "/Manage/{leagueId:int}/boardmembers/create"
@model TrentonDarts.Web.Pages.Manage.BoardMembers.CreateModel
@{
    ViewData["Title"] = "Add Board Member";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">Add Board Member</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/boardmembers" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Back</a>
</div>

<form method="post" class="max-w-xl">
    @await Html.PartialAsync("_BoardMemberFields", Model.Input)
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#2563EB;color:#fff;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/boardmembers" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Cancel</a>
    </div>
</form>

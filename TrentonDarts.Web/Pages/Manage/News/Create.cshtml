@page "/Manage/{leagueId:int}/news/create"
@model TrentonDarts.Web.Pages.Manage.News.CreateModel
@{
    ViewData["Title"] = "Add News Post";
    Layout = "_ManageLayout";
}
@section Scripts {
    <script src="/dist/tiptap-editor.js"></script>
    <script>
        initTipTapEditor('tiptap-excerpt', 'Input_Excerpt', '');
        initTipTapEditor('tiptap-body', 'Input_Html', '', { imageUploadUrl: '/Manage/upload-image' });

        document.getElementById('Input_Title').addEventListener('input', function () {
            var slug = this.value
                .toLowerCase()
                .replace(/[^a-z0-9\s-]/g, '')
                .trim()
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-');
            document.getElementById('Input_Slug').value = slug;
        });
    </script>
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Add News Post</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/news" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
</div>

<form method="post" enctype="multipart/form-data" class="max-w-xl">
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Title *</label>
        <input asp-for="Input.Title" id="Input_Title" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
        <span asp-validation-for="Input.Title" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Slug *</label>
        <input asp-for="Input.Slug" id="Input_Slug" class="w-full rounded-lg px-3 py-1.5 text-sm font-mono" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
        <span asp-validation-for="Input.Slug" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Excerpt</label>
        <input type="hidden" asp-for="Input.Excerpt" id="Input_Excerpt" />
        <div id="tiptap-excerpt" style="border-radius:0.5rem;overflow:hidden"></div>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Body</label>
        <input type="hidden" asp-for="Input.Html" id="Input_Html" />
        <div id="tiptap-body" style="border-radius:0.5rem;overflow:hidden"></div>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Post Type</label>
        <select asp-for="Input.PostType" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            <option value="News">News</option>
            <option value="Recap">Recap</option>
            <option value="Event">Event</option>
            <option value="Announcement">Announcement</option>
        </select>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Season</label>
        <select asp-for="Input.WinterSeasonId" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            <option value="">— None —</option>
            @foreach (var s in Model.Seasons)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Cover Image</label>
        <input asp-for="CoverImage" type="file" accept="image/*" class="w-full text-sm" style="color:#F5ECD7" />
        <p class="text-xs mt-1" style="color:#6B7280">Recommended: 1600 × 900 px (16:9). Larger images are center-cropped.</p>
        <span asp-validation-for="CoverImage" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-6">
        <label class="flex items-center gap-2 cursor-pointer">
            <input asp-for="Input.Publish" type="checkbox" class="rounded" />
            <span class="text-sm" style="color:#F5ECD7">Publish immediately</span>
        </label>
    </div>
    <div class="flex gap-3">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/news" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Cancel</a>
    </div>
</form>

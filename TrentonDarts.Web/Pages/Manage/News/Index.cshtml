@page "/Manage/{leagueId:int}/news"
@model TrentonDarts.Web.Pages.Manage.News.IndexModel
@{
    ViewData["Title"] = "News Posts";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">News Posts</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/news/create" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#C8962E;color:#0A0A0B;text-decoration:none">Add Post</a>
</div>

<div class="glass-card overflow-x-auto">
<table class="w-full text-sm">
    <thead>
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Title</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Slug</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Status</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Created</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var post in Model.Posts)
    {
        <tr style="border-bottom:1px solid rgba(255,255,255,0.06)"
            onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
            <td class="px-3 py-2">@post.Title</td>
            <td class="px-3 py-2" style="color:#9CA3AF">@post.Slug</td>
            <td class="px-3 py-2">
                @if (post.IsDraft)
                {
                    <span class="px-2 py-0.5 rounded text-xs" style="background:rgba(255,255,255,0.08);color:#9CA3AF">Draft</span>
                }
                else
                {
                    <span class="px-2 py-0.5 rounded text-xs" style="background:rgba(34,197,94,0.15);color:#4ade80">Published</span>
                }
            </td>
            <td class="px-3 py-2" style="color:#9CA3AF">@post.CreatedAt.ToString("MM/dd/yyyy")</td>
            <td class="px-3 py-2" style="white-space:nowrap">
                <a href="/Manage/@Model.LeagueId/news/@post.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Edit</a>
                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete @post.Title?')">
                    <input type="hidden" name="id" value="@post.Id" />
                    <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#C8101A;color:#fff;border:none">Delete</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Posts.Any())
    {
        <tr>
            <td colspan="5" class="px-3 py-6 text-center text-sm" style="color:#6B7280">No posts yet.</td>
        </tr>
    }
    </tbody>
</table>
</div>

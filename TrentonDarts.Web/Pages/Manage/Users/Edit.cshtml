@page "/Manage/{leagueId:int}/users/{userId}/edit"
@model TrentonDarts.Web.Pages.Manage.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">Edit User</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/users" class="inline-block px-3 py-1.5 rounded text-sm font-medium"
       style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Back</a>
</div>

@if (Model.EditUser != null)
{
    <div class="glass-card p-4 mb-5 max-w-xl">
        <p class="text-sm" style="color:#6B7280">Account</p>
        <p class="font-semibold mt-0.5">@Model.EditUser.Name</p>
        <p class="text-sm mt-0.5" style="color:#6B7280">@Model.EditUser.Email</p>
    </div>
}

<form method="post" class="max-w-xl">
    <div asp-validation-summary="ModelOnly" class="mb-4 p-3 rounded-lg text-sm"
         style="background:rgba(200,16,26,0.15);color:#fca5a5;border:1px solid rgba(200,16,26,0.3)"></div>

    <div class="mb-4">
        <label class="block text-sm font-medium mb-1" style="color:#6B7280">Role</label>
        <select name="Input.Role" class="w-full rounded-lg px-3 py-2 text-sm"
                style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB">
            @if (string.IsNullOrEmpty(Model.Input.Role)) { <option value="" selected>— No role —</option> }
            else { <option value="">— No role —</option> }
            @foreach (var role in TrentonDarts.Web.Data.Roles.All)
            {
                if (Model.Input.Role == role) { <option value="@role" selected>@role</option> }
                else { <option value="@role">@role</option> }
            }
        </select>
    </div>

    <div class="mb-4">
        <label class="block text-sm font-medium mb-1" style="color:#6B7280">Linked Player</label>
        <select name="Input.PlayerId" class="w-full rounded-lg px-3 py-2 text-sm"
                style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB">
            @if (Model.Input.PlayerId == null) { <option value="" selected>— None —</option> }
            else { <option value="">— None —</option> }
            @foreach (var p in Model.Players)
            {
                if (Model.Input.PlayerId == p.Id) { <option value="@p.Id" selected>@p.Name</option> }
                else { <option value="@p.Id">@p.Name</option> }
            }
        </select>
    </div>

    <div class="mb-4">
        <label class="block text-sm font-medium mb-1" style="color:#6B7280">Linked Board Member</label>
        <select name="Input.BoardMemberId" class="w-full rounded-lg px-3 py-2 text-sm"
                style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB">
            @if (Model.Input.BoardMemberId == null) { <option value="" selected>— None —</option> }
            else { <option value="">— None —</option> }
            @foreach (var bm in Model.BoardMembers)
            {
                if (Model.Input.BoardMemberId == bm.Id) { <option value="@bm.Id" selected>@bm.Name</option> }
                else { <option value="@bm.Id">@bm.Name</option> }
            }
        </select>
    </div>

    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer"
                style="background:#2563EB;color:#fff;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/users" class="inline-block px-4 py-2 rounded-lg text-sm font-medium"
           style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Cancel</a>
    </div>
</form>

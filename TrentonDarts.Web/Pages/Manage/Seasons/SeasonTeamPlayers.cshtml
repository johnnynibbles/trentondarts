@page "/Manage/{leagueId:int}/seasons/{id:int}/teams/{seasonTeamId:int}/players"
@model TrentonDarts.Web.Pages.Manage.Seasons.SeasonTeamPlayersModel
@{
    ViewData["Title"] = "Team Players";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">@Model.TeamName – Players</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/seasons/@Model.Id" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
</div>

<form method="post" asp-page-handler="Add" class="flex flex-wrap items-end gap-3 mb-5">
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Player</label>
        <select name="playerId" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var p in Model.AvailablePlayers)
            {
                <option value="@p.Id">@p.FirstName @p.LastName</option>
            }
        </select>
    </div>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Role</label>
        <select name="role" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var r in new[] { "Player", "Captain", "Co-Captain" })
            {
                <option value="@r">@r</option>
            }
        </select>
    </div>
    <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Add</button>
</form>

<div class="glass-card overflow-x-auto">
<table class="w-full text-sm">
    <thead>
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Player</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Role</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var tp in Model.TeamPlayers)
    {
        <tr style="border-bottom:1px solid rgba(255,255,255,0.06)"
            onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
            <td class="px-3 py-2">@tp.Player.Name</td>
            <td class="px-3 py-2">@tp.Role</td>
            <td class="px-3 py-2">
                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Remove player?')">
                    <input type="hidden" name="seasonTeamPlayerId" value="@tp.Id" />
                    <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#C8101A;color:#fff;border:none">Remove</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

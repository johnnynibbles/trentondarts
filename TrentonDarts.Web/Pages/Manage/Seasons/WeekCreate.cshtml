@page "/Manage/{leagueId:int}/seasons/{id:int}/weeks/create"
@model TrentonDarts.Web.Pages.Manage.Seasons.WeekCreateModel
@{
    ViewData["Title"] = "Add Week";
    Layout = "_ManageLayout";
}

<h2>Add Week</h2>
<a href="/Manage/@Model.LeagueId/seasons/@Model.Id" class="btn btn-default">Back</a>
<br/><br/>

<form method="post" class="form-horizontal">
    <div class="form-group">
        <label class="col-sm-2 control-label">Date *</label>
        <div class="col-sm-3">
            <input asp-for="Input.Date" class="form-control" type="date"
                   value="@Model.Input.Date.ToString("yyyy-MM-dd")" />
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-2 control-label">Week Type *</label>
        <div class="col-sm-3">
            <select asp-for="Input.WeekType" class="form-control">
                @foreach (var opt in new[] { ("pre","Pre Season"), ("regular","Regular Season") })
                {
                    if (opt.Item1 == Model.Input.WeekType) { <option value="@opt.Item1" selected>@opt.Item2</option> }
                    else { <option value="@opt.Item1">@opt.Item2</option> }
                }
            </select>
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</form>

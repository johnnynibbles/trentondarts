@page "/Manage/{leagueId:int}/seasons/{id:int}/weeks/create"
@model TrentonDarts.Web.Pages.Manage.Seasons.WeekCreateModel
@{
    ViewData["Title"] = "Add Week";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Add Week</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/seasons/@Model.Id" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
</div>

<form method="post" class="max-w-xl">
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Date *</label>
        <input asp-for="Input.Date" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" type="date"
               value="@Model.Input.Date.ToString("yyyy-MM-dd")" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Week Type *</label>
        <select asp-for="Input.WeekType" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var opt in new[] { ("pre","Pre Season"), ("regular","Regular Season") })
            {
                if (opt.Item1 == Model.Input.WeekType) { <option value="@opt.Item1" selected>@opt.Item2</option> }
                else { <option value="@opt.Item1">@opt.Item2</option> }
            }
        </select>
    </div>
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/seasons/@Model.Id" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Cancel</a>
    </div>
</form>

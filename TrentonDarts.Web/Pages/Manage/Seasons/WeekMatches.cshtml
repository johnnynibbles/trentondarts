@page "/Manage/{leagueId:int}/seasons/{id:int}/weeks/{weekId:int}/matches"
@model TrentonDarts.Web.Pages.Manage.Seasons.WeekMatchesModel
@{
    ViewData["Title"] = "Week Matches";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">@Model.WeekDate.ToString("MM/dd/yyyy") – Matches</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/seasons/@Model.Id" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
</div>

<form method="post" asp-page-handler="Add" class="flex flex-wrap items-end gap-3 mb-5">
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Away Team</label>
        <select name="awayTeamId" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var t in Model.Teams)
            {
                <option value="@t.TeamId">@t.Team.Name</option>
            }
        </select>
    </div>
    <span class="text-sm pb-2" style="color:#9CA3AF">@@</span>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Home Team</label>
        <select name="homeTeamId" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var t in Model.Teams)
            {
                <option value="@t.TeamId">@t.Team.Name</option>
            }
        </select>
    </div>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Division</label>
        <input name="division" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12);width:80px" />
    </div>
    <div>
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Match Type</label>
        <select name="matchTypeId" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var mt in Model.MatchTypes)
            {
                <option value="@mt.Id">@mt.Name</option>
            }
        </select>
    </div>
    <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Add</button>
</form>

<div class="glass-card overflow-x-auto">
<table class="w-full text-sm">
    <thead>
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Away</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Home</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Division</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Type</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var m in Model.Matches)
    {
        <tr style="border-bottom:1px solid rgba(255,255,255,0.06)"
            onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
            <td class="px-3 py-2">@m.AwayTeam.Name</td>
            <td class="px-3 py-2">@m.HomeTeam.Name</td>
            <td class="px-3 py-2">@m.Division</td>
            <td class="px-3 py-2">@m.MatchType.Name</td>
            <td class="px-3 py-2">
                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete this match?')">
                    <input type="hidden" name="matchId" value="@m.Id" />
                    <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#C8101A;color:#fff;border:none">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@page "/Manage/{leagueId:int}/seasons"
@model TrentonDarts.Web.Pages.Manage.Seasons.IndexModel
@{
    ViewData["Title"] = "Seasons";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Seasons</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/seasons/create" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#C8962E;color:#0A0A0B;text-decoration:none">Add Season</a>
</div>

<div class="glass-card overflow-x-auto">
<table class="w-full text-sm">
    <thead>
        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Name</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Years</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Current</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var s in Model.Seasons)
    {
        <tr style="border-bottom:1px solid rgba(255,255,255,0.06)"
            onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
            <td class="px-3 py-2">@s.Name</td>
            <td class="px-3 py-2">@s.StartYear – @s.EndYear</td>
            <td class="px-3 py-2">@(s.IsCurrent ? "Yes" : "")</td>
            <td class="px-3 py-2">
                <a href="/Manage/@Model.LeagueId/seasons/@s.Id" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Manage</a>
                <a href="/Manage/@Model.LeagueId/seasons/@s.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Edit</a>
                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete @s.Name?')">
                    <input type="hidden" name="id" value="@s.Id" />
                    <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#C8101A;color:#fff;border:none">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@page "/Manage/{leagueId:int}/seasons/{id:int}/teams/{seasonTeamId:int}/edit"
@model TrentonDarts.Web.Pages.Manage.Seasons.SeasonTeamEditModel
@{
    ViewData["Title"] = "Edit Season Team";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Edit Season Team</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/seasons/@Model.Id" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
</div>

<form method="post" class="max-w-xl">
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Pre-Season Division</label>
        <input asp-for="Input.PreSeasonDiv" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Regular Season Division</label>
        <input asp-for="Input.RegularSeasonDiv" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
    </div>
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/seasons/@Model.Id" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Cancel</a>
    </div>
</form>

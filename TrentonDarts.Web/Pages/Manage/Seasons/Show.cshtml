@page "/Manage/{leagueId:int}/seasons/{id:int}"
@model TrentonDarts.Web.Pages.Manage.Seasons.ShowModel
@{
    ViewData["Title"] = Model.Season?.Name ?? "Season";
    Layout = "_ManageLayout";
}

<h2>@Model.Season?.Name</h2>
<a href="/Manage/@Model.LeagueId/seasons" class="btn btn-default">Back</a>
<a href="/Manage/@Model.LeagueId/seasons/@Model.Id/edit" class="btn btn-default">Edit Season</a>
<a href="/Manage/@Model.LeagueId/seasons/@Model.Id/resetStats" class="btn btn-warning"
   onclick="return confirm('Recalculate all stats for this season?')">Reset Stats</a>
<a href="/Manage/@Model.LeagueId/seasons/@Model.Id/exportPlayers" class="btn btn-default">Export Players CSV</a>
<br/><br/>

<div class="row">
    <div class="col-sm-6">
        <h3>Teams <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/teams/create" class="btn btn-xs btn-primary">Add</a></h3>
        <table class="table table-bordered table-condensed">
            <thead>
                <tr><th>Team</th><th>Pre Div</th><th>Reg Div</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var st in Model.SeasonTeams)
            {
                <tr>
                    <td><a href="/Manage/@Model.LeagueId/seasons/@Model.Id/teams/@st.Id/players">@st.Team.Name</a></td>
                    <td>@st.PreSeasonDiv</td>
                    <td>@st.RegularSeasonDiv</td>
                    <td>
                        <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/teams/@st.Id/edit" class="btn btn-xs btn-default">Edit</a>
                        <form method="post" asp-page-handler="DeleteTeam" style="display:inline;"
                              onsubmit="return confirm('Remove team from season?')">
                            <input type="hidden" name="seasonTeamId" value="@st.Id" />
                            <button type="submit" class="btn btn-xs btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="col-sm-6">
        <h3>Weeks <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/weeks/create" class="btn btn-xs btn-primary">Add</a></h3>
        <table class="table table-bordered table-condensed">
            <thead>
                <tr><th>Date</th><th>Type</th><th>Matches</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var w in Model.Weeks)
            {
                <tr>
                    <td>@w.Date.ToString("MM/dd/yyyy")</td>
                    <td>@w.WeekType</td>
                    <td>@w.Matches.Count</td>
                    <td>
                        <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/weeks/@w.Id/matches" class="btn btn-xs btn-default">Matches</a>
                        <form method="post" asp-page-handler="DeleteWeek" style="display:inline;"
                              onsubmit="return confirm('Delete week?')">
                            <input type="hidden" name="weekId" value="@w.Id" />
                            <button type="submit" class="btn btn-xs btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@page "/Manage/{leagueId:int}/seasons/{id:int}"
@model TrentonDarts.Web.Pages.Manage.Seasons.ShowModel
@{
    ViewData["Title"] = Model.Season?.Name ?? "Season";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">@Model.Season?.Name</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/seasons" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Back</a>
    <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/edit" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Edit Season</a>
    <form method="post" action="/Manage/@Model.LeagueId/seasons/@Model.Id/resetStats" onsubmit="return confirm('Recalculate all stats for this season?')" style="display:inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#D97706;color:#fff;border:none;cursor:pointer">Reset Stats</button>
    </form>
    <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/exportPlayers" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Export Players CSV</a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <div>
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-bold" style="color:#111827">Teams</h3>
            <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/teams/create" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#2563EB;color:#fff;text-decoration:none">Add</a>
        </div>
        <div class="glass-card overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Team</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Pre Div</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Reg Div</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var st in Model.SeasonTeams)
            {
                <tr style="border-bottom:1px solid #F3F4F6"
                    onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                    <td class="px-3 py-2"><a href="/Manage/@Model.LeagueId/seasons/@Model.Id/teams/@st.Id/players" style="color:#2563EB;text-decoration:none">@st.Team.Name</a></td>
                    <td class="px-3 py-2">@st.PreSeasonDiv</td>
                    <td class="px-3 py-2">@st.RegularSeasonDiv</td>
                    <td class="px-3 py-2">
                        <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/teams/@st.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Edit</a>
                        <form method="post" asp-page-handler="DeleteTeam" style="display:inline" onsubmit="return confirm('Remove team from season?')">
                            <input type="hidden" name="seasonTeamId" value="@st.Id" />
                            <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#DC2626;color:#fff;border:none">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </div>
    <div>
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-lg font-bold" style="color:#111827">Weeks</h3>
            <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/weeks/create" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#2563EB;color:#fff;text-decoration:none">Add</a>
        </div>
        <div class="glass-card overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Date</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Type</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Matches</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var w in Model.Weeks)
            {
                <tr style="border-bottom:1px solid #F3F4F6"
                    onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
                    <td class="px-3 py-2">@w.Date.ToString("MM/dd/yyyy")</td>
                    <td class="px-3 py-2">@w.WeekType</td>
                    <td class="px-3 py-2">@w.Matches.Count</td>
                    <td class="px-3 py-2">
                        <a href="/Manage/@Model.LeagueId/seasons/@Model.Id/weeks/@w.Id/matches" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Matches</a>
                        <form method="post" asp-page-handler="DeleteWeek" style="display:inline" onsubmit="return confirm('Delete week?')">
                            <input type="hidden" name="weekId" value="@w.Id" />
                            <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#DC2626;color:#fff;border:none">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </div>
</div>

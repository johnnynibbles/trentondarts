@model TrentonDarts.Web.Pages.Manage.Players.PlayerInput

<div class="form-group">
    <label class="col-sm-2 control-label">User ID</label>
    <div class="col-sm-4">
        <input asp-for="UserId" class="form-control" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">First Name *</label>
    <div class="col-sm-4">
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Last Name *</label>
    <div class="col-sm-4">
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Nickname</label>
    <div class="col-sm-4">
        <input asp-for="Nickname" class="form-control" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Email</label>
    <div class="col-sm-4">
        <input asp-for="Email" class="form-control" type="email" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Home Phone</label>
    <div class="col-sm-4">
        <input asp-for="HomePhone" class="form-control" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Cell Phone</label>
    <div class="col-sm-4">
        <input asp-for="CellPhone" class="form-control" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Shirt Size</label>
    <div class="col-sm-2">
        <select asp-for="ShirtSize" class="form-control">
            <option value="">-- select --</option>
            @foreach (var s in new[] { "S","M","L","XL","XXL","XXXL" })
            {
                if (s == Model?.ShirtSize) { <option value="@s" selected>@s</option> }
                else { <option value="@s">@s</option> }
            }
        </select>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Address</label>
    <div class="col-sm-6">
        <input asp-for="Address1" class="form-control" placeholder="Address Line 1" />
    </div>
</div>
<div class="form-group">
    <div class="col-sm-offset-2 col-sm-6">
        <input asp-for="Address2" class="form-control" placeholder="Address Line 2" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">City</label>
    <div class="col-sm-4">
        <input asp-for="City" class="form-control" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">State</label>
    <div class="col-sm-2">
        <input asp-for="State" class="form-control" maxlength="2" />
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Zip</label>
    <div class="col-sm-2">
        <input asp-for="Zip" class="form-control" />
    </div>
</div>
<div class="form-group">
    <div class="col-sm-offset-2 col-sm-10">
        <div class="checkbox">
            <label><input asp-for="AcceptEmail" /> Accept Email</label>
        </div>
        <div class="checkbox">
            <label><input asp-for="AcceptText" /> Accept Text</label>
        </div>
    </div>
</div>
<div class="form-group">
    <label class="col-sm-2 control-label">Notes</label>
    <div class="col-sm-6">
        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
    </div>
</div>

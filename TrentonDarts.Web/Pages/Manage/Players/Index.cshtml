@page "/Manage/{leagueId:int}/players"
@model TrentonDarts.Web.Pages.Manage.Players.IndexModel
@{
    ViewData["Title"] = "Players";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">Players</h2>

<div class="flex flex-wrap items-center gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/players/create" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#2563EB;color:#fff;text-decoration:none">Add Player</a>
    <input id="player-search" type="search" placeholder="Search players…" autocomplete="off"
           class="rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB;min-width:200px" />
</div>

<div class="glass-card overflow-x-auto">
<table class="w-full text-sm" id="players-table">
    <thead>
        <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Name</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Email</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Players)
    {
        <tr style="border-bottom:1px solid #F3F4F6"
            onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
            <td class="px-3 py-2">@p.FirstName @p.LastName @(p.Nickname != null ? $"({p.Nickname})" : "")</td>
            <td class="px-3 py-2">@p.Email</td>
            <td class="px-3 py-2">
                <a href="/Manage/@Model.LeagueId/players/@p.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Edit</a>
                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete @p.FirstName @p.LastName?')">
                    <input type="hidden" name="id" value="@p.Id" />
                    <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#DC2626;color:#fff;border:none">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@section Scripts {
<script>
(function () {
    var input = document.getElementById('player-search');
    var rows = document.querySelectorAll('#players-table tbody tr');
    input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        rows.forEach(function (row) {
            row.style.display = row.cells[0].textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    });
})();
</script>
}

@page "/Manage/{leagueId:int}/navigation"
@model TrentonDarts.Web.Pages.Manage.Navigation.NavigationIndexModel
@{
    ViewData["Title"] = "Navigation";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Navigation</h2>
<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
    <a href="/Manage/@Model.LeagueId/navigation/group/create" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#C8962E;color:#0A0A0B;text-decoration:none">New Group</a>
</div>

@if (!Model.Groups.Any())
{
    <p style="color:#9CA3AF">No navigation groups yet. Create one to get started.</p>
}
else
{
    @foreach (var group in Model.Groups)
    {
        <div class="glass-card mb-4">
            <div class="px-4 py-3 flex items-center justify-between" style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
                <div>
                    <span class="font-semibold text-sm" style="color:#F5ECD7">@group.Title</span>
                    <span class="text-xs ml-2" style="color:#9CA3AF">(@group.Items.Count items, order: @group.SortOrder)</span>
                </div>
                <div class="flex items-center gap-1">
                    <form method="post" style="display:inline">
                        <input type="hidden" name="groupId" value="@group.Id" />
                        <button type="submit" asp-page-handler="MoveGroupUp" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:rgba(255,255,255,0.08);color:#F5ECD7;border:none">↑</button>
                        <button type="submit" asp-page-handler="MoveGroupDown" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:rgba(255,255,255,0.08);color:#F5ECD7;border:none">↓</button>
                    </form>
                    <a href="/Manage/@Model.LeagueId/navigation/group/@group.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Edit</a>
                    <form method="post" style="display:inline" onsubmit="return confirm('Delete this group and all its items?')">
                        <input type="hidden" name="groupId" value="@group.Id" />
                        <button type="submit" asp-page-handler="DeleteGroup" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#C8101A;color:#fff;border:none">Delete</button>
                    </form>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
                            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Title</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Type</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">URL / Document</th>
                            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in group.Items)
                        {
                            <tr style="border-bottom:1px solid rgba(255,255,255,0.06)"
                                onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
                                <td class="px-3 py-2" style="color:#F5ECD7">
                                    @item.Title
                                    @if (item.IsHeader) { <span class="ml-1 px-1.5 py-0.5 rounded text-xs" style="background:rgba(255,255,255,0.1);color:#9CA3AF">Header</span> }
                                    @if (item.IsSeparator) { <span class="ml-1 px-1.5 py-0.5 rounded text-xs" style="background:rgba(255,255,255,0.1);color:#9CA3AF">Divider</span> }
                                </td>
                                <td class="px-3 py-2">
                                    @switch (item.ItemType)
                                    {
                                        case TrentonDarts.Web.Data.Entities.NavItemType.InternalLink:
                                            <span class="px-1.5 py-0.5 rounded text-xs" style="background:rgba(59,130,246,0.2);color:#93C5FD">Internal</span>
                                            break;
                                        case TrentonDarts.Web.Data.Entities.NavItemType.ExternalUrl:
                                            <span class="px-1.5 py-0.5 rounded text-xs" style="background:rgba(245,158,11,0.2);color:#FCD34D">External</span>
                                            break;
                                        case TrentonDarts.Web.Data.Entities.NavItemType.Document:
                                            <span class="px-1.5 py-0.5 rounded text-xs" style="background:rgba(34,197,94,0.2);color:#86EFAC">Document</span>
                                            break;
                                    }
                                </td>
                                <td class="px-3 py-2 text-xs" style="color:#9CA3AF;max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                    @if (item.ItemType == TrentonDarts.Web.Data.Entities.NavItemType.Document)
                                    {
                                        @(item.BrowsableFile?.Title ?? item.BrowsableFile?.FileName ?? "—")
                                    }
                                    else
                                    {
                                        @item.UrlTemplate
                                    }
                                </td>
                                <td class="px-3 py-2" style="white-space:nowrap">
                                    <form method="post" style="display:inline">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" asp-page-handler="MoveItemUp" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:rgba(255,255,255,0.08);color:#F5ECD7;border:none">↑</button>
                                        <button type="submit" asp-page-handler="MoveItemDown" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:rgba(255,255,255,0.08);color:#F5ECD7;border:none">↓</button>
                                    </form>
                                    <a href="/Manage/@Model.LeagueId/navigation/group/@group.Id/item/@item.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Edit</a>
                                    <form method="post" style="display:inline" onsubmit="return confirm('Delete this item?')">
                                        <input type="hidden" name="itemId" value="@item.Id" />
                                        <button type="submit" asp-page-handler="DeleteItem" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#C8101A;color:#fff;border:none">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="px-3 py-2">
                    <a href="/Manage/@Model.LeagueId/navigation/group/@group.Id/item/create" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#C8962E;color:#0A0A0B;text-decoration:none">+ Add Item</a>
                </div>
            </div>
        </div>
    }
}

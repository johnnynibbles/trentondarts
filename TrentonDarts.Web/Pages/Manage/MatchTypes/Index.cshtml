@page "/Manage/{leagueId:int}/matchtypes"
@model TrentonDarts.Web.Pages.Manage.MatchTypes.IndexModel
@{
    ViewData["Title"] = "Match Types";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">Match Types</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/matchtypes/create" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#2563EB;color:#fff;text-decoration:none">Add Match Type</a>
</div>

<div class="glass-card overflow-x-auto">
<table class="w-full text-sm">
    <thead>
        <tr style="border-bottom:1px solid #E5E7EB;background:#F9FAFB">
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Name</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Rules</th>
            <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#6B7280">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var mt in Model.MatchTypes)
    {
        <tr style="border-bottom:1px solid #F3F4F6"
            onmouseover="this.style.background='#F9FAFB'" onmouseout="this.style.background=''">
            <td class="px-3 py-2">@mt.Name</td>
            <td class="px-3 py-2">@mt.GameRules.Count</td>
            <td class="px-3 py-2" style="white-space:nowrap">
                <a href="/Manage/@Model.LeagueId/matchtypes/@mt.Id/rules" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Rules</a>
                <a href="/Manage/@Model.LeagueId/matchtypes/@mt.Id/edit" class="inline-block px-2 py-0.5 rounded text-xs font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Edit</a>
                <form method="post" asp-page-handler="Delete" style="display:inline" onsubmit="return confirm('Delete @mt.Name and all its rules?')">
                    <input type="hidden" name="id" value="@mt.Id" />
                    <button type="submit" class="px-2 py-0.5 rounded text-xs font-medium cursor-pointer" style="background:#DC2626;color:#fff;border:none">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

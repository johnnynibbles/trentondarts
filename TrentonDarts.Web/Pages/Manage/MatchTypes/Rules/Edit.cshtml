@page "/Manage/{leagueId:int}/matchtypes/{matchTypeId:int}/rules/{id:int}/edit"
@model TrentonDarts.Web.Pages.Manage.MatchTypes.Rules.EditRuleModel
@{
    ViewData["Title"] = "Edit Rule";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Edit Rule — @Model.MatchTypeName</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/matchtypes/@Model.MatchTypeId/rules" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
</div>

<form method="post" class="max-w-xl">
    <div asp-validation-summary="All" class="mb-4 p-3 rounded-lg text-sm" style="background:rgba(200,16,26,0.15);color:#fca5a5;border:1px solid rgba(200,16,26,0.3)"></div>

    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Order *</label>
        <input asp-for="Input.OrderId" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" type="number" min="1" />
        <span asp-validation-for="Input.OrderId" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Game Type *</label>
        <select asp-for="Input.GameType" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" asp-items="Model.GameTypeOptions"></select>
        <span asp-validation-for="Input.GameType" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Group Name</label>
        <input asp-for="Input.GroupName" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" placeholder="e.g. Cricket" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Who Starts</label>
        <select asp-for="Input.WhoStarts" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" asp-items="Model.WhoStartsOptions"></select>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Players</label>
        <input asp-for="Input.NumberOfPlayers" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" type="number" min="1" max="8" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Legs</label>
        <input asp-for="Input.NumberOfLegs" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" type="number" min="1" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Best Of Legs</label>
        <input asp-for="Input.BestOfNumberOfLegs" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" type="number" min="0" />
        <span class="text-xs mt-1 block" style="color:#6B7280">0 = fixed number of legs</span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Game Points</label>
        <input asp-for="Input.GamePointValue" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" type="number" min="0" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Leg Points</label>
        <input asp-for="Input.LegPointValue" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" type="number" min="0" />
    </div>
    <div class="mb-4">
        <label class="flex items-center gap-2 text-sm cursor-pointer mb-2" style="color:#F5ECD7">
            <input asp-for="Input.DoubleIn" type="checkbox" class="rounded" />
            Double In
        </label>
        <label class="flex items-center gap-2 text-sm cursor-pointer mb-2" style="color:#F5ECD7">
            <input asp-for="Input.DoubleOut" type="checkbox" class="rounded" />
            Double Out
        </label>
        <label class="flex items-center gap-2 text-sm cursor-pointer" style="color:#F5ECD7">
            <input asp-for="Input.ForfeitIfNoPlayers" type="checkbox" class="rounded" />
            Forfeit If No Players
        </label>
    </div>
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/matchtypes/@Model.MatchTypeId/rules" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Cancel</a>
    </div>
</form>

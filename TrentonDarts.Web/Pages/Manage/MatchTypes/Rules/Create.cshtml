@page "/Manage/{leagueId:int}/matchtypes/{matchTypeId:int}/rules/create"
@model TrentonDarts.Web.Pages.Manage.MatchTypes.Rules.CreateRuleModel
@{
    ViewData["Title"] = "New Rule";
    Layout = "_ManageLayout";
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">New Rule — @Model.MatchTypeName</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/matchtypes/@Model.MatchTypeId/rules" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Back</a>
</div>

<form method="post" class="max-w-xl">
    <div asp-validation-summary="All" class="mb-4 p-3 rounded-lg text-sm" style="background:rgba(200,16,26,0.15);color:#fca5a5;border:1px solid rgba(200,16,26,0.3)"></div>

    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Order *</label>
        <input asp-for="Input.OrderId" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" type="number" min="1" />
        <span asp-validation-for="Input.OrderId" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Game Type *</label>
        <select asp-for="Input.GameType" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" asp-items="Model.GameTypeOptions"></select>
        <span asp-validation-for="Input.GameType" class="text-xs mt-1 block" style="color:#C8101A"></span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Group Name</label>
        <input asp-for="Input.GroupName" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" placeholder="e.g. Cricket" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Who Starts</label>
        <select asp-for="Input.WhoStarts" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" asp-items="Model.WhoStartsOptions"></select>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Players</label>
        <input asp-for="Input.NumberOfPlayers" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" type="number" min="1" max="8" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Legs</label>
        <input asp-for="Input.NumberOfLegs" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" type="number" min="1" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Best Of Legs</label>
        <input asp-for="Input.BestOfNumberOfLegs" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" type="number" min="0" />
        <span class="text-xs mt-1 block" style="color:#6B7280">0 = fixed number of legs</span>
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Game Points</label>
        <input asp-for="Input.GamePointValue" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" type="number" min="0" />
    </div>
    <div class="mb-4">
        <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Leg Points</label>
        <input asp-for="Input.LegPointValue" class="w-full rounded-lg px-3 py-1.5 text-sm" style="background:#F9FAFB;color:#111827;border:1px solid #D1D5DB" type="number" min="0" />
    </div>
    <div class="mb-4">
        <label class="flex items-center gap-2 text-sm cursor-pointer mb-2" style="color:#111827">
            <input asp-for="Input.DoubleIn" type="checkbox" class="rounded" />
            Double In
        </label>
        <label class="flex items-center gap-2 text-sm cursor-pointer mb-2" style="color:#111827">
            <input asp-for="Input.DoubleOut" type="checkbox" class="rounded" />
            Double Out
        </label>
        <label class="flex items-center gap-2 text-sm cursor-pointer" style="color:#111827">
            <input asp-for="Input.ForfeitIfNoPlayers" type="checkbox" class="rounded" />
            Forfeit If No Players
        </label>
    </div>
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#2563EB;color:#fff;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/matchtypes/@Model.MatchTypeId/rules" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Cancel</a>
    </div>
</form>

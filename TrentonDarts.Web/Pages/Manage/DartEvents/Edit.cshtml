@page "/Manage/{leagueId:int}/dartevents/{id:int}/edit"
@model TrentonDarts.Web.Pages.Manage.DartEvents.EditModel
@{
    ViewData["Title"] = "Edit Dart Event";
    Layout = "_ManageLayout";
}
@section Scripts {
    <script src="/dist/tiptap-editor.js"></script>
    <script>
        initTipTapEditor('tiptap-description', 'Description', document.getElementById('Description').value);
    </script>
}

<h2 class="text-2xl font-bold mb-4" style="color:#111827">Edit Dart Event</h2>

<div class="flex flex-wrap gap-2 mb-5">
    <a href="/Manage/@Model.LeagueId/dartevents" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Back</a>
    <a href="/Manage/@Model.LeagueId/dartevents/@Model.Id/results" class="inline-block px-3 py-1.5 rounded text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Manage Results</a>
</div>

<form method="post" class="max-w-xl">
    @await Html.PartialAsync("_DartEventFields", Model.Input)
    <div class="flex gap-3 mt-6">
        <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#2563EB;color:#fff;border:none">Save</button>
        <a href="/Manage/@Model.LeagueId/dartevents" class="inline-block px-4 py-2 rounded-lg text-sm font-medium" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;text-decoration:none">Cancel</a>
    </div>
</form>

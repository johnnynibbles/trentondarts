@page "/news"
@model TrentonDarts.Web.Pages.News.IndexModel
@using TrentonDarts.Web.Data.Entities
@{
    ViewData["Title"] = "News";

    static (string bg, string color) PostTypeBadgeStyle(NewsPostType type) => type switch
    {
        NewsPostType.Recap        => ("oklch(18% 0.06 145)", "oklch(70% 0.15 145)"),
        NewsPostType.Event        => ("var(--color-gold-bg)", "var(--color-gold)"),
        NewsPostType.Announcement => ("oklch(18% 0.06 30)", "oklch(70% 0.15 30)"),
        _                         => ("oklch(18% 0.06 255)", "oklch(70% 0.15 255)"),
    };
}

<h2 class="text-3xl font-bold mb-2" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">News</h2>

<form method="get" class="mb-6 flex gap-2 max-w-md">
    <input type="text" name="q" value="@Model.Query" placeholder="Search posts…"
           class="flex-1 rounded-lg px-3 py-1.5 text-sm"
           style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
    <button type="submit" class="px-3 py-1.5 rounded-lg text-sm font-medium cursor-pointer"
            style="background:#C8962E;color:#0A0A0B;border:none">Search</button>
    @if (!string.IsNullOrEmpty(Model.Query))
    {
        <a href="/news" class="inline-block px-3 py-1.5 rounded-lg text-sm"
           style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Clear</a>
    }
</form>

@if (!Model.Posts.Any())
{
    <div class="glass-card px-6 py-10 text-center">
        <p class="text-sm" style="color:#6B7280">
            @(string.IsNullOrEmpty(Model.Query) ? "No news posts published yet." : "No posts match your search.")
        </p>
    </div>
}
else
{
    <div class="grid gap-6">
        @foreach (var post in Model.Posts)
        {
            var (badgeBg, badgeColor) = PostTypeBadgeStyle(post.PostType);
            <article class="glass-card flex gap-4 overflow-hidden" style="border-radius:0.75rem">
                @if (post.CoverImage != null)
                {
                    <a href="/news/@post.Slug" style="flex-shrink:0;display:block;width:160px">
                        <img src="/file/@post.CoverImage.Id" alt="@post.Title" style="width:160px;height:120px;object-fit:cover" />
                    </a>
                }
                <div class="p-4 flex flex-col justify-center">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="inline-block rounded px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide"
                              style="background:@badgeBg;color:@badgeColor">@post.PostType</span>
                        <span class="text-xs" style="color:#6B7280">@post.PublishedAt?.ToString("MMMM d, yyyy")</span>
                    </div>
                    <a href="/news/@post.Slug" class="text-lg font-bold mb-1 block"
                       style="font-family:'Rajdhani',sans-serif;color:#F5ECD7;text-decoration:none">@post.Title</a>
                    @if (!string.IsNullOrEmpty(post.Excerpt))
                    {
                        <div class="prose-content text-sm" style="color:#9CA3AF">@Html.Raw(post.Excerpt)</div>
                    }
                </div>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex gap-2 mt-6 justify-center">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                var iCopy = i;
                var isActive = iCopy == Model.CurrentPage;
                <a href="/news?page=@iCopy@(!string.IsNullOrEmpty(Model.Query) ? $"&q={Uri.EscapeDataString(Model.Query)}" : "")"
                   class="px-3 py-1 rounded text-sm"
                   style="background:@(isActive ? "#C8962E" : "rgba(255,255,255,0.08)");color:@(isActive ? "#0A0A0B" : "#F5ECD7");text-decoration:none">
                    @i
                </a>
            }
        </div>
    }
}

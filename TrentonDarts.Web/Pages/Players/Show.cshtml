@page "/player/{id:int}"
@model TrentonDarts.Web.Pages.Players.ShowModel
@{
    ViewData["Title"] = $"{Model.Player.Name} — {Model.Season.Name}";
}

<div class="flex items-start justify-between flex-wrap gap-3 mb-5">
    <div>
        <h2 class="text-3xl font-bold" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">
            @Model.Player.Name
        </h2>
        <p class="text-sm mt-0.5" style="color:#9CA3AF">
            @if (Model.PlayerTeam != null)
            {
                <span>on </span><a href="/team/@Model.PlayerTeam.Id?season=@Model.Season.Id" style="color:#C8962E;text-decoration:none">@Model.PlayerTeam.Name</a>
            }
            else { <span>No Team</span> }
            <span class="mx-2" style="color:#6B7280">&bull;</span>
            @Model.Season.Name
            <span class="mx-2" style="color:#6B7280">&bull;</span>
            <a href="/player/@Model.Player.Id?season=@Model.Season.Id&groupby=gameType" style="color:#6B7280;text-decoration:none;font-size:0.75rem">Group by game type</a>
        </p>
    </div>
</div>

<div class="flex flex-col lg:flex-row gap-5">

    @* Game history *@
    <div class="flex-1 min-w-0">
        <div class="glass-card overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
                        <th class="px-3 py-2 text-center text-xs font-semibold uppercase tracking-wider" style="color:#6B7280">Game</th>
                        <th class="px-3 py-2 text-center text-xs font-semibold uppercase tracking-wider" style="color:#6B7280">#</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider" style="color:#6B7280">Partner</th>
                        <th class="px-3 py-2 text-center text-xs font-semibold uppercase tracking-wider" style="color:#6B7280">Result</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider" style="color:#6B7280">Opponents</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.GameHistories.Any())
                {
                    <tr><td colspan="5" class="px-3 py-6 text-center text-sm" style="color:#6B7280">Currently No Matches</td></tr>
                }
                else
                {
                    int lastMatchId = 0;
                    @foreach (var gh in Model.GameHistories)
                    {
                        if (lastMatchId != gh.MatchId)
                        {
                            lastMatchId = gh.MatchId;
                            var matchUrl = Model.IsBoardMember
                                ? $"/season/{Model.Season.Id}/match/{gh.MatchId}/edit"
                                : $"/season/{Model.Season.Id}/match/{gh.MatchId}";
                            <tr style="border-bottom:1px solid rgba(255,255,255,0.06);background:rgba(255,255,255,0.03)">
                                <td colspan="5" class="px-3 py-2">
                                    <strong>
                                        <a href="@matchUrl" class="mr-3" style="color:#C8962E;text-decoration:none">
                                            <i class="fa-regular fa-note-sticky mr-1"></i>@gh.Date.ToString("MM-dd-yyyy")
                                            <span class="text-xs ml-1" style="color:#6B7280">@(gh.SeasonPart == "pre" ? "Pre" : "Reg")</span>
                                        </a>
                                        <a href="/team/@gh.OpponentTeamId?season=@Model.Season.Id" style="color:#F5ECD7;text-decoration:none">
                                            @(gh.IsHomeGame ? "vs" : "@@") @gh.OpponentTeamName
                                        </a>
                                    </strong>
                                </td>
                            </tr>
                        }
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.04)"
                            onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
                            <td class="px-3 py-2 text-center text-xs" style="color:#9CA3AF">@gh.GameType</td>
                            <td class="px-3 py-2 text-center text-xs" style="color:#6B7280">@gh.GameOrder</td>
                            <td class="px-3 py-2">
                                @foreach (var mate in gh.TeamPlayers)
                                {
                                    <div><a href="/player/@mate.Id?season=@Model.Season.Id" style="color:#F5ECD7;text-decoration:none">@mate.Name</a></div>
                                }
                            </td>
                            <td class="px-3 py-2 text-center">
                                @if (gh.IsWon)
                                {
                                    <span class="badge-win">Won</span>
                                }
                                else
                                {
                                    <span class="badge-loss">Lost</span>
                                }
                            </td>
                            <td class="px-3 py-2">
                                @foreach (var opp in gh.Opponents)
                                {
                                    <div><a href="/player/@opp.Id?season=@Model.Season.Id" style="color:#F5ECD7;text-decoration:none">@opp.Name</a></div>
                                }
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    @* Teammate sidebar *@
    @if (Model.PlayerTeam != null)
    {
        <div class="lg:w-64 shrink-0">
            <div class="glass-card overflow-hidden">
                <div class="px-4 py-2" style="border-bottom:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.04)">
                    <span class="text-sm font-bold uppercase tracking-wide" style="font-family:'Rajdhani',sans-serif;color:#C8962E">@Model.PlayerTeam.Name</span>
                </div>
                <table class="w-full text-sm">
                    <thead>
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.06)">
                            <th class="px-3 py-1.5 text-left text-xs" style="color:#6B7280">Player</th>
                            <th class="px-3 py-1.5 text-center text-xs" style="color:#6B7280">W–L</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var ps in Model.TeamPlayerStats.OrderByDescending(p => p.OverallWin).ThenByDescending(p => p.GamesPlayed))
                    {
                        var isCurrentPlayer = ps.PlayerId == Model.Player.Id;
                        <tr style="border-bottom:1px solid rgba(255,255,255,0.04);@(isCurrentPlayer ? "background:rgba(200,150,46,0.1)" : "")"
                            onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='@(isCurrentPlayer ? "rgba(200,150,46,0.1)" : "")'">
                            <td class="px-3 py-2">
                                <a href="/player/@ps.PlayerId?season=@Model.Season.Id"
                                   style="text-decoration:none;color:@(isCurrentPlayer ? "#C8962E" : "#F5ECD7");@(isCurrentPlayer ? "font-weight:600" : "")">
                                    @ps.PlayerName
                                </a>
                            </td>
                            <td class="px-3 py-2 text-center text-xs font-mono">@ps.GamesWon–@ps.GamesLost</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

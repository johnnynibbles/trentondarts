@page "/events/results"
@model TrentonDarts.Web.Pages.Events.ResultsModel
@{
    ViewData["Title"] = "Event Results";
}

<h2 class="text-3xl font-bold mb-2 text-center" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Greater Trenton Dart League</h2>
<p class="text-center mb-5 text-sm" style="color:#9CA3AF">Player Activity in Events</p>

<div class="glass-card overflow-x-auto">
    <table class="w-full text-sm">
        <thead>
            <tr style="border-bottom:1px solid rgba(255,255,255,0.1);background:rgba(255,255,255,0.04)">
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Event</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Date</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Specific Event</th>
                <th class="px-3 py-2 text-left text-xs font-semibold" style="color:#9CA3AF">Player</th>
                <th class="px-3 py-2 text-center text-xs font-semibold" style="color:#9CA3AF">Finish</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.EventResults.Any())
        {
            <tr><td colspan="5" class="px-3 py-6 text-center text-sm" style="color:#6B7280">Currently No Results</td></tr>
        }
        else
        {
            @foreach (var r in Model.EventResults)
            {
                <tr style="border-bottom:1px solid rgba(255,255,255,0.04)"
                    onmouseover="this.style.background='rgba(255,255,255,0.03)'" onmouseout="this.style.background=''">
                    <td class="px-3 py-2">@r.EventName</td>
                    <td class="px-3 py-2 text-xs" style="color:#9CA3AF">@r.EventDate?.ToString("MM-dd-yyyy")</td>
                    <td class="px-3 py-2">@r.SpecificEvent</td>
                    <td class="px-3 py-2">@r.PlayerName</td>
                    <td class="px-3 py-2 text-center font-bold" style="color:#C8962E">@r.Place</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

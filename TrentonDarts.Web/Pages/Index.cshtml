@page
@model TrentonDarts.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Greater Trenton Dart League";
    Layout = "_Layout";
}

@* ── Hero ─────────────────────────────────────────────────────────────────── *@
<section style="border-bottom:1px solid #E5E7EB;margin:-24px -24px 0">
    <div style="position:relative;height:130px;overflow:hidden">
        <img src="/images/trenton-makes-thin.jpg" alt="Trenton Makes, The World Takes"
             style="width:100%;height:100%;object-fit:cover;object-position:center;display:block">
        <div style="position:absolute;inset:0;background:rgba(0,0,0,0.42);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px">
            <span style="font-size:clamp(18px,3vw,30px);font-weight:800;letter-spacing:0.18em;text-transform:uppercase;color:#FFFFFF;line-height:1">Greater Trenton</span>
            <span style="font-size:clamp(11px,1.8vw,20px);font-weight:700;letter-spacing:0.3em;text-transform:uppercase;color:#F59E0B;line-height:1">Dart League</span>
        </div>
    </div>
    <div style="max-width:1200px;margin:0 auto;padding:14px 24px">
        <div style="display:inline-flex;align-items:center;gap:7px;padding:4px 10px;border-radius:100px;background:#EFF6FF;border:1px solid #BFDBFE;font-size:12px;font-weight:600;color:#2563EB;letter-spacing:0.02em;text-transform:uppercase">
            <span style="width:7px;height:7px;border-radius:50%;background:#16A34A;display:inline-block;flex-shrink:0"></span>
            @if (Model.CurrentSeasonId.HasValue)
            {
                <text>Season in progress</text>
            }
            else
            {
                <text>Greater Trenton Dart League</text>
            }
        </div>
    </div>
</section>

@* ── Main: content + sidebar ──────────────────────────────────────────────── *@
<div class="main-wrap" style="margin:0 -24px">

    @* ── Left: news / content ─────────────────────────────────────────────── *@
    <div class="posts-col">

        <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:20px">
            <h2 style="font-size:17px;font-weight:700;letter-spacing:-0.02em;color:#111827">League News</h2>
        </div>

        <div class="posts-stack">

            @* Upcoming event *@
            @if (Model.TitleEvent != null)
            {
                <article class="post-card">
                    <div class="post-meta">
                        <span class="tag tag-event">Event</span>
                        @if (Model.TitleEvent.EventDate.HasValue)
                        {
                            <time class="post-date">@Model.TitleEvent.EventDate.Value.ToString("MMMM d, yyyy")</time>
                        }
                    </div>
                    <h2>@Model.TitleEvent.Name</h2>
                </article>
            }

            @* Welcome / main page content *@
            @if (!string.IsNullOrWhiteSpace(Model.WelcomeMessage))
            {
                <article class="post-card">
                    <div class="post-meta">
                        <span class="tag tag-news">News</span>
                    </div>
                    <div style="font-size:15px;line-height:1.65;color:#374151">
                        @Html.Raw(Model.WelcomeMessage)
                    </div>
                </article>
            }

            @* Player of the week *@
            @if (!string.IsNullOrWhiteSpace(Model.PlayerOfTheWeek))
            {
                <article class="post-card">
                    <div class="post-meta">
                        <span class="tag tag-announce">Spotlight</span>
                    </div>
                    <div style="font-size:15px;line-height:1.65;color:#374151">
                        @Html.Raw(Model.PlayerOfTheWeek)
                    </div>
                </article>
            }

            @* Featured link *@
            <article class="post-card">
                <div class="post-meta">
                    <span class="tag" style="background:#F3F4F6;color:#374151">History</span>
                </div>
                <p style="font-size:14px;color:#6B7280;line-height:1.6">
                    Check out this
                    <a href="http://www.si.com/vault/1975/02/17/557875/eight-feet-away-from-glory" target="_blank" rel="noopener noreferrer"
                       style="color:#2563EB;font-weight:600">Sports Illustrated article on darts from 1975</a>.
                    Our own Conrad Daniels is a key part!
                </p>
            </article>

        </div>
    </div>

    @* ── Right: standings + schedule ──────────────────────────────────────── *@
    <aside class="sidebar" aria-label="Standings and schedule">

        @* Standings widget *@
        @if (Model.Standings.Any())
        {
            <div class="widget">
                <div class="widget-head">
                    <span class="widget-title">
                        <i class="fa-solid fa-ranking-star mr-1" style="color:#2563EB"></i>Standings
                    </span>
                    @if (Model.CurrentSeasonId.HasValue)
                    {
                        <a href="/season/@Model.CurrentSeasonId" style="font-size:13px;color:#2563EB;font-weight:500;text-decoration:none">Full →</a>
                    }
                </div>
                @{ var firstDiv = true; }
                @foreach (var div in Model.Standings)
                {
                    if (!firstDiv)
                    {
                        <div style="border-top:1px solid #E5E7EB"></div>
                    }
                    firstDiv = false;

                    if (!string.IsNullOrEmpty(div.Name))
                    {
                        <div style="padding:8px 12px 4px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#DC2626">Division @div.Name</div>
                    }
                    <table class="standings-tbl">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Team</th>
                                <th class="r">W</th>
                                <th class="r">L</th>
                                <th class="r">Pct</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var rank = 1; }
                            @foreach (var team in div.Standings)
                            {
                                var posClass = rank == 1 ? "pos-1" : rank == 2 ? "pos-2" : rank == 3 ? "pos-3" : "pos-n";
                                <tr>
                                    <td><span class="pos @posClass">@rank</span></td>
                                    <td><span class="team-nm">@team.Name</span></td>
                                    <td class="r" style="color:#16A34A;font-weight:600">@team.WonPoints</td>
                                    <td class="r" style="color:#DC2626;font-weight:600">@team.LossPoints</td>
                                    <td class="r" style="color:#6B7280;font-size:12px">@team.Percentage.ToString("F3")</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        @* Schedule widget *@
        <div class="widget">
            <div class="widget-head">
                <span class="widget-title">
                    <i class="fa-solid fa-calendar-days mr-1" style="color:#2563EB"></i>Schedule
                </span>
                @if (Model.CurrentSeasonId.HasValue)
                {
                    <a href="/season/@Model.CurrentSeasonId/schedule" style="font-size:13px;color:#2563EB;font-weight:500;text-decoration:none">Full →</a>
                }
            </div>
            @if (Model.UpcomingWeekDate.HasValue)
            {
                <div style="padding:10px 18px;border-bottom:1px solid #E5E7EB;font-size:11px;font-weight:600;color:#6B7280;text-transform:uppercase;letter-spacing:0.05em">
                    @Model.UpcomingWeekDate.Value.ToString("MMMM d, yyyy")
                </div>
                @if (Model.UpcomingMatches.Any())
                {
                    var byDiv = Model.UpcomingMatches.GroupBy(m => m.Division ?? "").OrderBy(g => g.Key).ToList();
                    foreach (var divGroup in byDiv)
                    {
                        @foreach (var match in divGroup)
                        {
                            <div class="matchup">
                                <div class="matchup-teams">
                                    <span>@match.HomeTeamName</span>
                                    <span class="vs">vs</span>
                                    <span>@match.AwayTeamName</span>
                                </div>
                                @if (!string.IsNullOrEmpty(divGroup.Key))
                                {
                                    <div class="matchup-venue">Div @divGroup.Key</div>
                                }
                            </div>
                        }
                    }
                }
                else
                {
                    <div style="padding:16px 18px;font-size:13px;color:#6B7280">No matches scheduled.</div>
                }
            }
            else
            {
                <div style="padding:16px 18px;font-size:13px;color:#6B7280">No upcoming schedule.</div>
            }
        </div>

    </aside>
</div>

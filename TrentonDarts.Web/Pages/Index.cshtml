@page
@model TrentonDarts.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Greater Trenton Dart League";
}

<div class="text-center mb-6">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-wide mb-2" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">
        Greater Trenton Dart League
    </h1>
    <div class="w-16 h-0.5 mx-auto" style="background:#C8101A"></div>
</div>

<div class="flex flex-col lg:flex-row gap-6 items-start">

    @* ── Left sidebar: widgets ──────────────────────────────────────────── *@
    <aside class="w-full lg:w-72 shrink-0 flex flex-col gap-5">

        @* Schedule widget *@
        <div class="glass-card p-4">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-base font-bold uppercase tracking-widest" style="font-family:'Rajdhani',sans-serif;color:#C8962E">
                    <i class="fa-solid fa-calendar-days mr-1.5"></i>Schedule
                </h2>
                @if (Model.CurrentSeasonId.HasValue)
                {
                    <a href="/season/@Model.CurrentSeasonId/schedule" class="text-xs"
                       style="color:#6B7280;text-decoration:none"
                       onmouseover="this.style.color='#F5ECD7'" onmouseout="this.style.color='#6B7280'">Full schedule →</a>
                }
            </div>
            @if (Model.UpcomingWeekDate.HasValue)
            {
                <p class="text-xs font-semibold mb-2" style="color:#6B7280">@Model.UpcomingWeekDate.Value.ToString("MMMM d, yyyy")</p>
                @if (Model.UpcomingMatches.Any())
                {
                    var byDiv = Model.UpcomingMatches.GroupBy(m => m.Division ?? "").OrderBy(g => g.Key).ToList();
                    foreach (var div in byDiv)
                    {
                        if (!string.IsNullOrEmpty(div.Key))
                        {
                            <p class="text-xs font-semibold uppercase tracking-wider mt-2 mb-1" style="color:#C8101A">Division @div.Key</p>
                        }
                        foreach (var match in div)
                        {
                            <div class="flex items-center gap-1 py-1 border-t text-xs" style="border-color:rgba(255,255,255,0.06)">
                                <span class="flex-1 truncate text-right" style="color:#F5ECD7">@match.HomeTeamName</span>
                                <span class="shrink-0 text-center" style="color:#4B5563">vs</span>
                                <span class="flex-1 truncate" style="color:#F5ECD7">@match.AwayTeamName</span>
                            </div>
                        }
                    }
                }
                else
                {
                    <p class="text-xs" style="color:#6B7280">No matches scheduled.</p>
                }
            }
            else
            {
                <p class="text-xs" style="color:#6B7280">No upcoming schedule.</p>
            }
        </div>

        @* Standings widget *@
        @if (Model.Standings.Any())
        {
            <div class="glass-card p-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-base font-bold uppercase tracking-widest" style="font-family:'Rajdhani',sans-serif;color:#C8962E">
                        <i class="fa-solid fa-ranking-star mr-1.5"></i>Standings
                    </h2>
                    @if (Model.CurrentSeasonId.HasValue)
                    {
                        <a href="/season/@Model.CurrentSeasonId" class="text-xs"
                           style="color:#6B7280;text-decoration:none"
                           onmouseover="this.style.color='#F5ECD7'" onmouseout="this.style.color='#6B7280'">Full →</a>
                    }
                </div>
                @{ var firstDiv = true; }
                @foreach (var div in Model.Standings)
                {
                    if (!firstDiv) { <div class="mt-3"></div> }
                    firstDiv = false;
                    <p class="text-xs font-semibold uppercase tracking-wider mb-1" style="color:#C8101A">Division @div.Name</p>
                    <table class="w-full text-xs">
                        <thead>
                            <tr style="color:#6B7280">
                                <th class="text-left pb-1 font-medium">Team</th>
                                <th class="text-center pb-1 font-medium w-6">W</th>
                                <th class="text-center pb-1 font-medium w-6">L</th>
                                <th class="text-right pb-1 font-medium w-10">Pct</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var team in div.Standings)
                            {
                                <tr class="border-t" style="border-color:rgba(255,255,255,0.06)">
                                    <td class="py-1 pr-2" style="color:#F5ECD7;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@team.Name</td>
                                    <td class="py-1 text-center" style="color:#F5ECD7">@team.WonPoints</td>
                                    <td class="py-1 text-center" style="color:#F5ECD7">@team.LossPoints</td>
                                    <td class="py-1 text-right" style="color:#9CA3AF">@team.Percentage.ToString("F3")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

    </aside>

    @* ── Right panel: content ───────────────────────────────────────────── *@
    <main class="flex-1 min-w-0 flex flex-col gap-5">

        @if (Model.TitleEvent != null)
        {
            <div class="glass-card p-5" style="border-left:2px solid #C8962E">
                <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:#C8962E">Upcoming Event</p>
                <h3 class="text-xl font-bold mb-1" style="font-family:'Rajdhani',sans-serif">@Model.TitleEvent.Name</h3>
                <p class="text-sm" style="color:#9CA3AF">@Model.TitleEvent.EventDate?.ToString("MMMM d, yyyy")</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.WelcomeMessage))
        {
            <div class="important-message">
                @Html.Raw(Model.WelcomeMessage)
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.PlayerOfTheWeek))
        {
            <div class="important-message">
                @Html.Raw(Model.PlayerOfTheWeek)
            </div>
        }

        <div class="glass-card p-4">
            <p class="text-sm" style="color:#9CA3AF">
                Check out this interesting
                <a href="http://www.si.com/vault/1975/02/17/557875/eight-feet-away-from-glory" target="_blank" rel="noopener noreferrer"
                   class="font-semibold" style="color:#C8962E">Sports Illustrated article on darts from 1975</a>.
                Our own Conrad Daniels is a key part!
            </p>
        </div>

    </main>

</div>

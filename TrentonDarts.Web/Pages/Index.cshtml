@page
@model TrentonDarts.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Greater Trenton Dart League";
}

<div class="text-center mb-8">
    <h1 class="text-3xl sm:text-4xl font-bold tracking-wide mb-2" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">
        Welcome to the Greater Trenton Dart League
    </h1>
    <div class="w-16 h-0.5 mx-auto" style="background:#C8101A"></div>
</div>

<div class="important-message mb-6">
    @Html.Raw(Model.WelcomeMessage)
    @Html.Raw(Model.PlayerOfTheWeek)
</div>

@if (Model.CurrentSeasonId.HasValue)
{
    var sid = Model.CurrentSeasonId.Value;
    <div class="flex flex-wrap justify-center gap-2 mb-6">
        <a href="/season/@sid" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors"
           style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#F5ECD7;text-decoration:none"
           onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
            <i class="fa-solid fa-ranking-star mr-1.5" style="color:#C8962E"></i>Standings
        </a>
        <a href="/season/@sid/schedule" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors"
           style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#F5ECD7;text-decoration:none"
           onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
            <i class="fa-solid fa-calendar-days mr-1.5" style="color:#C8962E"></i>Schedule
        </a>
        <a href="/season/@sid/stats" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors"
           style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#F5ECD7;text-decoration:none"
           onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
            <i class="fa-solid fa-chart-bar mr-1.5" style="color:#C8962E"></i>Stats
        </a>
        <a href="/season/@sid/awards" class="px-4 py-2 rounded-lg text-sm font-medium transition-colors"
           style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);color:#F5ECD7;text-decoration:none"
           onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
            <i class="fa-solid fa-trophy mr-1.5" style="color:#C8962E"></i>Awards
        </a>
    </div>
}

@if (Model.TitleEvent != null)
{
    <div class="glass-card p-5 mb-6 max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:#C8962E">Upcoming Event</p>
        <h3 class="text-xl font-bold mb-1" style="font-family:'Rajdhani',sans-serif">@Model.TitleEvent.Name</h3>
        <p class="text-sm" style="color:#9CA3AF">@Model.TitleEvent.EventDate?.ToString("MMMM d, yyyy")</p>
    </div>
}

<div class="glass-card p-4 text-center max-w-2xl">
    <p class="text-sm" style="color:#9CA3AF">
        Check out this interesting
        <a href="http://www.si.com/vault/1975/02/17/557875/eight-feet-away-from-glory" target="_blank" rel="noopener noreferrer"
           class="font-semibold" style="color:#C8962E">Sports Illustrated article on darts from 1975</a>.
        Our own Conrad Daniels is a key part!
    </p>
</div>

@page "/Auth/Register"
@model TrentonDarts.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="flex items-center justify-center min-h-[60vh]">
    <div class="glass-card p-8 w-full max-w-sm">
        <h2 class="text-2xl font-bold mb-6 text-center" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Register</h2>
        <div asp-validation-summary="All" class="mb-4 p-3 rounded-lg text-sm" style="background:rgba(200,16,26,0.15);color:#fca5a5;border:1px solid rgba(200,16,26,0.3);display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>
        <form method="post">
            <div class="mb-4">
                <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Name</label>
                <input asp-for="Name" class="w-full rounded-lg px-3 py-2 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
            </div>
            <div class="mb-4">
                <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Email</label>
                <input asp-for="Email" type="email" class="w-full rounded-lg px-3 py-2 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
            </div>
            <div class="mb-4">
                <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Password</label>
                <input asp-for="Password" type="password" class="w-full rounded-lg px-3 py-2 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
            </div>
            <div class="mb-6">
                <label class="block text-xs font-semibold uppercase tracking-wider mb-1" style="color:#6B7280">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="w-full rounded-lg px-3 py-2 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)" />
            </div>
            <div class="flex gap-3">
                <button type="submit" class="flex-1 py-2 rounded-lg text-sm font-semibold cursor-pointer" style="background:#C8962E;color:#0A0A0B;border:none">Register</button>
                <a href="/Auth/Login" class="flex-1 py-2 rounded-lg text-sm text-center" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Have an account?</a>
            </div>
        </form>
    </div>
</div>

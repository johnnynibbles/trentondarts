@page "/Auth/Register"
@model TrentonDarts.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-eyebrow">Greater Trenton Dart League</div>
        <h1 class="auth-title">Create Account</h1>
        <div asp-validation-summary="All" class="auth-error" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block")"></div>
        <form method="post">
            <div class="auth-field">
                <label class="auth-label" asp-for="Name">Name</label>
                <input asp-for="Name" class="auth-input" autocomplete="name" />
            </div>
            <div class="auth-field">
                <label class="auth-label" asp-for="Email">Email</label>
                <input asp-for="Email" type="email" class="auth-input" autocomplete="email" />
            </div>
            <div class="auth-field">
                <label class="auth-label" asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="auth-input" autocomplete="new-password" />
            </div>
            <div class="auth-field" style="margin-bottom:1.25rem">
                <label class="auth-label" asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" class="auth-input" autocomplete="new-password" />
            </div>
            <div style="margin-bottom:1.25rem">
                <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-theme="light"></div>
            </div>
            <button type="submit" class="auth-btn">Create Account</button>
        </form>
        <div class="auth-divider"></div>
        <a href="/Auth/Login" class="auth-btn-ghost">Already have an account?</a>
    </div>
</div>

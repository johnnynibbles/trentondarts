@page "/Auth/ConfirmEmail"
@model TrentonDarts.Web.Pages.Auth.ConfirmEmailModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email Confirmed" : "Confirmation Failed";
}

<div class="auth-wrap">
    <div class="auth-card" style="text-align:center">
        @if (Model.Succeeded)
        {
            <div class="auth-status-icon success">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="auth-eyebrow" style="display:block">Verification Complete</div>
            <h1 class="auth-title" style="font-size:1.6rem;margin-bottom:0.75rem">Email Confirmed</h1>
            <p style="color:#6B7280;font-size:0.82rem;line-height:1.65;margin-bottom:1.75rem">
                Your email address has been verified.<br>You can now sign in to your account.
            </p>
            <a href="/Auth/Login" class="auth-btn">Sign In</a>
        }
        else
        {
            <div class="auth-status-icon error">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
            </div>
            <div class="auth-eyebrow" style="display:block;color:#f87171">Verification Failed</div>
            <h1 class="auth-title" style="font-size:1.6rem;margin-bottom:0.75rem">Link Expired</h1>
            <p style="color:#6B7280;font-size:0.82rem;line-height:1.65;margin-bottom:1.75rem">
                The confirmation link is invalid or has expired.<br>Please register again or contact support.
            </p>
            <a href="/Auth/Register" class="auth-btn" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB">Back to Register</a>
        }
    </div>
</div>

@page "/Auth/Login"
@model TrentonDarts.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-eyebrow">Greater Trenton Dart League</div>
        <h1 class="auth-title">Sign In</h1>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }
        <form method="post">
            <div class="auth-field">
                <label class="auth-label" asp-for="Email">Email</label>
                <input asp-for="Email" type="email" class="auth-input" autocomplete="email" />
            </div>
            <div class="auth-field" style="margin-bottom:1.75rem">
                <label class="auth-label" asp-for="Password">Password</label>
                <input asp-for="Password" type="password" class="auth-input" autocomplete="current-password" />
            </div>
            <button type="submit" class="auth-btn">Sign In</button>
        </form>
        <div class="auth-divider"></div>
        <a href="/Auth/Register" class="auth-btn-ghost">Create an account</a>
    </div>
</div>

@page "/Auth/RegisterConfirmation"
@model TrentonDarts.Web.Pages.Auth.RegisterConfirmationModel
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="auth-wrap">
    <div class="auth-card" style="text-align:center">
        <div class="auth-status-icon success" style="background:#EFF6FF;color:#2563EB">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
        </div>
        <div class="auth-eyebrow" style="justify-content:center;display:block">Account Created</div>
        <h1 class="auth-title" style="font-size:1.6rem;margin-bottom:0.75rem">Check Your Inbox</h1>
        <p style="color:#6B7280;font-size:0.82rem;line-height:1.65;margin-bottom:1.5rem">
            We've sent a confirmation link to your email address.<br>
            Click the link to activate your account.
        </p>
        <p style="color:#6B7280;font-size:0.72rem">Didn't receive an email? Check your spam folder.</p>
    </div>
</div>

@page "/Auth/RegisterConfirmation"
@model TrentonDarts.Web.Pages.Auth.RegisterConfirmationModel
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="flex items-center justify-center min-h-[60vh]">
    <div class="glass-card p-8 w-full max-w-sm text-center">
        <div class="mb-4" style="color:#C8962E">
            <svg xmlns="http://www.w3.org/2000/svg" class="mx-auto mb-3" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
        </div>
        <h2 class="text-2xl font-bold mb-2" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">Check Your Email</h2>
        <p class="text-sm mb-6" style="color:#9CA3AF">
            We've sent a confirmation link to your email address. Click the link in the email to activate your account.
        </p>
        <p class="text-xs" style="color:#6B7280">Didn't receive an email? Check your spam folder.</p>
    </div>
</div>

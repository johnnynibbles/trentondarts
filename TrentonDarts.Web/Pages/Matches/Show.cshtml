@page "/season/{seasonId:int}/match/{id:int}"
@model TrentonDarts.Web.Pages.Matches.ShowModel
@{
    ViewData["Title"] = $"{Model.Match.AwayTeam.Name} @ {Model.Match.HomeTeam.Name}";
}

<div id="scoresheet">
    <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
        <h2 class="text-2xl font-bold" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">
            @Model.Season.Name
        </h2>
        <select id="matchesThisWeek" class="rounded-lg px-3 py-1.5 text-sm" style="background:#111214;color:#F5ECD7;border:1px solid rgba(255,255,255,0.12)">
            @foreach (var kv in Model.MatchesThisWeek)
            {
                @if (kv.Key == Model.SelectedMatchRoute) { <option value="@kv.Key" selected>@kv.Value</option> }
                else { <option value="@kv.Key">@kv.Value</option> }
            }
        </select>
    </div>

    <h3 class="text-xl font-bold mb-4" style="font-family:'Rajdhani',sans-serif;color:#F5ECD7">
        @Model.Match.AwayTeam.Name <span style="color:#6B7280">@@</span> @Model.Match.HomeTeam.Name
    </h3>

    <div data-bind="visible: !hasScorecard()">
        <div class="scoresheet-row header">
            <div class="scoresheet-col-team">@Model.Match.HomeTeam.Name</div>
            <div class="scoresheet-col-score"><span data-bind="html: homeScoreOverride"></span>–<span data-bind="html: awayScoreOverride"></span></div>
            <div class="scoresheet-col-team" style="text-align:right">@Model.Match.AwayTeam.Name</div>
        </div>
        <p class="text-center py-4 text-sm" style="color:#6B7280">No Scorecard Available</p>
    </div>

    <div data-bind="visible: hasScorecard()">
        <div class="scoresheet-row header">
            <div class="scoresheet-col-team">@Model.Match.HomeTeam.Name</div>
            <div class="scoresheet-col-score"><span data-bind="html: homeScore"></span>–<span data-bind="html: awayScore"></span></div>
            <div class="scoresheet-col-team" style="text-align:right">@Model.Match.AwayTeam.Name</div>
        </div>
    </div>

    <div class="score-sheet" data-bind="foreach: gameGroups, visible: hasScorecard()">
        <div class="game-group-header" data-bind="html: name"></div>
        <div data-bind="template: {name: 'gameTemplate', foreach: games}"></div>
    </div>

    <div data-bind="visible: hasScorecard()">
        <div class="scoresheet-row footer">
            <div class="scoresheet-col-team">@Model.Match.HomeTeam.Name</div>
            <div class="scoresheet-col-score"><span data-bind="html: homeScore"></span>–<span data-bind="html: awayScore"></span></div>
            <div class="scoresheet-col-team" style="text-align:right">@Model.Match.AwayTeam.Name</div>
        </div>
    </div>

    <div class="flex gap-3 mt-5">
        <a href="/season/@Model.Season.Id" class="px-4 py-2 rounded-lg text-sm font-medium" style="background:rgba(255,255,255,0.08);color:#F5ECD7;text-decoration:none">Back</a>
        @if (Model.IsBoardMember)
        {
            <a href="/season/@Model.Season.Id/match/@Model.Match.Id/edit" class="px-4 py-2 rounded-lg text-sm font-medium" style="background:#C8962E;color:#0A0A0B;text-decoration:none">Edit</a>
        }
    </div>
</div>

<script type="text/html" id="gameTemplate">
    <div class="game">
        <div class="game-home-players">
            <div data-bind="if: forfeitedBy == 'home'" class="forfeit">Forfeit</div>
            <div data-bind="if: homePlayer"><span data-bind="html: homePlayer().name"></span></div>
            <div data-bind="if: homePlayer2"><span data-bind="html: homePlayer2().name"></span></div>
            <div data-bind="if: homePlayer3"><span data-bind="html: homePlayer3().name"></span></div>
        </div>
        <div class="game-result">
            <div data-bind="if: winner() == 'away'"><span class="label label-danger">L</span></div>
            <div data-bind="if: winner() == 'home'"><span class="label label-success">W</span></div>
        </div>
        <div class="game-score">
            <span data-bind="html: homeScore"></span>–<span data-bind="html: awayScore"></span>
        </div>
        <div class="game-result">
            <div data-bind="if: winner() == 'away'"><span class="label label-success">W</span></div>
            <div data-bind="if: winner() == 'home'"><span class="label label-danger">L</span></div>
        </div>
        <div class="game-away-players">
            <div data-bind="if: forfeitedBy == 'away'" class="forfeit">Forfeit</div>
            <div data-bind="if: awayPlayer"><span data-bind="html: awayPlayer().name"></span></div>
            <div data-bind="if: awayPlayer2"><span data-bind="html: awayPlayer2().name"></span></div>
            <div data-bind="if: awayPlayer3"><span data-bind="html: awayPlayer3().name"></span></div>
        </div>
        <div class="game-awards" data-bind="foreach: awards">
            <div>
                <strong><span data-bind="html: awardType"></span></strong>
                <span data-bind="if: awardValue() !== '' && awardValue() !== 0">(<span data-bind="html: awardValue"></span>)</span>
                <span data-bind="html: player().name"></span>
            </div>
        </div>
    </div>
</script>

@section Scripts {
    <script src="~/js/lodash.min.js"></script>
    <script src="~/js/postal.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/knockout/3.3.0/knockout-min.js"></script>
    <script>(window.ko || document.write("<script src='\/js\/knockout-3.3.0.js'><\/script>"));</script>
    <script src="//code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        (function(w){
            w.scoreCardConfig = {
                seasonId: "@Model.Season.Id",
                matchId: "@Model.Match.Id",
                match: @Html.Raw(Model.MatchResultsJson),
                awayPlayers: @Html.Raw(Model.AwayPlayersJson),
                homePlayers: @Html.Raw(Model.HomPlayersJson)
            };
        })(window);
    </script>
    <script src="~/js/scoresheet-edit.js"></script>
    <script>
        document.getElementById('matchesThisWeek').addEventListener('change', function() {
            window.location = this.value;
        });
    </script>
}

@page "/season/{seasonId:int}/match/{id:int}/edit"
@model TrentonDarts.Web.Pages.Matches.EditModel
@{
    ViewData["Title"] = $"Edit: {Model.Match.AwayTeam.Name} @ {Model.Match.HomeTeam.Name}";
}

<div id="scoresheet">
    <h2 class="text-2xl font-bold mb-1" style="color:#111827">
        @Model.Season.Name — Edit Scorecard
    </h2>
    <h3 class="text-xl font-bold mb-4" style="color:#111827">
        @Model.Match.AwayTeam.Name <span style="color:#6B7280">@@</span> @Model.Match.HomeTeam.Name
    </h3>

    <div data-bind="visible: !hasScorecard()">
        <div class="scoresheet-row header">
            <div class="scoresheet-col-team">@Model.Match.HomeTeam.Name</div>
            <div class="scoresheet-col-score" style="display:flex;flex-direction:column;align-items:center;gap:8px">
                <label style="color:#374151;font-size:0.85rem">
                    <input type="checkbox" data-bind="checked: hasScorecard" style="margin-right:4px"/>
                    Has Score Card
                </label>
                <div style="display:flex;align-items:center;gap:6px">
                    <input class="score-override-input" type="number" min="0" data-bind="value: homeScoreOverride" style="width:52px;text-align:center;background:#F9FAFB;color:#111827;border:1px solid #D1D5DB;border-radius:6px;padding:4px"/>
                    <span style="color:#6B7280">–</span>
                    <input class="score-override-input" type="number" min="0" data-bind="value: awayScoreOverride" style="width:52px;text-align:center;background:#F9FAFB;color:#111827;border:1px solid #D1D5DB;border-radius:6px;padding:4px"/>
                </div>
            </div>
            <div class="scoresheet-col-team" style="text-align:right">@Model.Match.AwayTeam.Name</div>
        </div>
    </div>

    <div data-bind="visible: hasScorecard()">
        <div class="scoresheet-row header">
            <div class="scoresheet-col-team">@Model.Match.HomeTeam.Name</div>
            <div class="scoresheet-col-score" style="display:flex;flex-direction:column;align-items:center;gap:6px">
                <label style="color:#374151;font-size:0.85rem">
                    <input type="checkbox" data-bind="checked: hasScorecard" style="margin-right:4px"/>
                    Has Score Card
                </label>
                <span><span data-bind="html: homeScore"></span>–<span data-bind="html: awayScore"></span></span>
            </div>
            <div class="scoresheet-col-team" style="text-align:right">@Model.Match.AwayTeam.Name</div>
        </div>

        <div class="score-sheet" data-bind="foreach: gameGroups">
            <div class="game-group-header" data-bind="html: name"></div>
            <div data-bind="template: {name: template, foreach: games, as: 'game'}"></div>
        </div>

        <div class="scoresheet-row footer">
            <div class="scoresheet-col-team">@Model.Match.HomeTeam.Name</div>
            <div class="scoresheet-col-score" style="display:flex;align-items:center;gap:10px">
                <button class="score-all-btn" data-bind="click: scoreAllHome" title="Score all games for Home">H</button>
                <span><span data-bind="html: homeScore"></span>–<span data-bind="html: awayScore"></span></span>
                <button class="score-all-btn" data-bind="click: scoreAllAway" title="Score all games for Away">A</button>
            </div>
            <div class="scoresheet-col-team" style="text-align:right">@Model.Match.AwayTeam.Name</div>
        </div>
    </div>

    <div class="flex gap-3 mt-5">
        <button data-bind="click: cancelMatchEdit" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB">Cancel</button>
        <button data-bind="click: saveMatch" class="px-4 py-2 rounded-lg text-sm font-medium cursor-pointer" style="background:#2563EB;color:#fff;border:none">Save</button>
    </div>
</div>

<script type="text/html" id="gameSinglePlayer">
    <div class="game">
        <div class="game-home-players">
            <div data-bind="if: game.forfeitedBy == 'home'" class="forfeit">Forfeit</div>
            <select data-bind="options: game.homePlayers, optionsText: 'name', optionsCaption: 'Choose Player', value: game.homePlayer"></select>
            <div data-bind="html: game.homePlayerMessage" class="player-warning"></div>
        </div>
        <!-- ko if: game.numberOfLegs === 1 -->
        <div class="game-result">
            <input type="radio" tabindex="-1" data-bind="checked: game.legs()[0], enable: game.homeScoreable" value="home"/>
        </div>
        <!-- /ko -->
        <div class="game-score">
            <!-- ko if: game.numberOfLegs > 1 -->
            <div class="leg-entries" data-bind="foreach: {data: game.legs, as: 'leg'}">
                <div class="leg-entry">
                    <span class="leg-label">Leg <span data-bind="html: $index() + 1"></span></span>
                    <label class="leg-radio"><input type="radio" tabindex="-1" data-bind="checked: leg, enable: game.homeScoreable" value="home"/> H</label>
                    <label class="leg-radio"><input type="radio" tabindex="-1" data-bind="checked: leg, enable: game.awayScoreable" value="away"/> A</label>
                </div>
            </div>
            <!-- /ko -->
            <div><span data-bind="html: game.homeScore"></span>&ndash;<span data-bind="html: game.awayScore"></span></div>
            <button class="award-btn" tabindex="-1" data-bind="click: game.newAward" title="New Award">+ Award</button>
        </div>
        <!-- ko if: game.numberOfLegs === 1 -->
        <div class="game-result">
            <input type="radio" tabindex="-1" data-bind="checked: game.legs()[0], enable: game.awayScoreable" value="away"/>
        </div>
        <!-- /ko -->
        <div class="game-away-players">
            <div data-bind="if: game.forfeitedBy == 'away'" class="forfeit">Forfeit</div>
            <select data-bind="options: game.awayPlayers, optionsText: 'name', optionsCaption: 'Choose Player', value: game.awayPlayer"></select>
            <div data-bind="html: game.awayPlayerMessage" class="player-warning"></div>
        </div>
        <div class="game-awards" data-bind="foreach: {data: game.awards, as: 'award'}">
            <div>
                <strong><span data-bind="html: award.awardType"></span></strong>
                <span data-bind="if: award.awardValue() !== '' && award.awardValue() !== 0"> (<span data-bind="html: award.awardValue"></span>)</span>
                <span data-bind="html: award.player().name"></span>
                <button class="delete-award-btn" tabindex="-1" data-bind="click: function(){ game.deleteAward(award); }">&times;</button>
            </div>
        </div>
    </div>
</script>


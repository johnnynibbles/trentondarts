<dialog id="awardModal" style="background:#FFFFFF;color:#111827;border:1px solid #E5E7EB;border-radius:12px;padding:24px;min-width:320px">
    <div id="awardForm">
        <h4 style="font-size:1.25rem;font-weight:700;margin-bottom:16px">Add Award</h4>
        <div style="margin-bottom:12px">
            <label style="display:block;font-size:0.85rem;color:#6B7280;margin-bottom:4px">Player</label>
            <select style="width:100%;background:#F9FAFB;color:#111827;border:1px solid #D1D5DB;border-radius:6px;padding:6px 10px"
                    data-bind="options: gamePlayers, optionsText: 'name', optionsCaption: 'Choose Player', value: player"></select>
        </div>
        <div style="margin-bottom:12px">
            <label style="display:block;font-size:0.85rem;color:#6B7280;margin-bottom:4px">Award Type</label>
            <select style="width:100%;background:#F9FAFB;color:#111827;border:1px solid #D1D5DB;border-radius:6px;padding:6px 10px"
                    data-bind="options: awardTypes, value: awardType"></select>
        </div>
        <div style="margin-bottom:20px">
            <label style="display:block;font-size:0.85rem;color:#6B7280;margin-bottom:4px">Value <span style="color:#9CA3AF">(optional)</span></label>
            <input type="text" style="width:100%;background:#F9FAFB;color:#111827;border:1px solid #D1D5DB;border-radius:6px;padding:6px 10px;box-sizing:border-box"
                   data-bind="value: awardValue"/>
        </div>
        <div style="display:flex;gap:10px;justify-content:flex-end">
            <button type="button" onclick="document.getElementById('awardModal').close()"
                    style="background:#F3F4F6;color:#374151;border:1px solid #E5E7EB;border-radius:6px;padding:8px 16px;cursor:pointer">
                Cancel
            </button>
            <button type="button" data-bind="click: save"
                    style="background:#2563EB;color:#fff;border:none;border-radius:6px;padding:8px 16px;cursor:pointer;font-weight:600">
                Save Award
            </button>
        </div>
    </div>
</dialog>

@section Scripts {
    <style>
        .score-all-btn {
            background: #EFF6FF;
            color: #2563EB;
            border: 1px solid #BFDBFE;
            border-radius: 4px;
            padding: 2px 8px;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.85rem;
        }
        .score-all-btn:hover { background: #DBEAFE; }
        .game select {
            background: #F9FAFB;
            color: #111827;
            border: 1px solid #D1D5DB;
            border-radius: 6px;
            padding: 4px 8px;
            font-size: 0.85rem;
            width: 100%;
            margin-bottom: 4px;
        }
        .game input[type="radio"] {
            accent-color: #2563EB;
            width: 18px;
            height: 18px;
            cursor: pointer;
        }
        .award-btn {
            background: #F3F4F6;
            color: #6B7280;
            border: 1px solid #E5E7EB;
            border-radius: 4px;
            padding: 2px 8px;
            cursor: pointer;
            font-size: 0.75rem;
            margin-top: 4px;
        }
        .award-btn:hover { background: #E5E7EB; color: #374151; }
        .delete-award-btn {
            background: #FEE2E2;
            color: #DC2626;
            border: none;
            border-radius: 4px;
            padding: 0 6px;
            cursor: pointer;
            font-size: 1rem;
            line-height: 1.4;
            margin-left: 6px;
        }
        .player-warning { color: #DC2626; font-size: 0.75rem; }
        .leg-entries { display: flex; flex-direction: column; gap: 4px; margin-bottom: 6px; }
        .leg-entry { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
        .leg-label { color: #6B7280; min-width: 40px; }
        .leg-radio { display: flex; align-items: center; gap: 3px; color: #374151; cursor: pointer; }
        dialog::backdrop { background: rgba(0,0,0,0.4); }
    </style>
    <script src="~/js/lodash.min.js"></script>
    <script src="~/js/postal.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/knockout/3.3.0/knockout-min.js"></script>
    <script>(window.ko || document.write("<script src='\/js\/knockout-3.3.0.js'><\/script>"));</script>
    <script src="//code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        (function(w){
            w.scoreCardConfig = {
                seasonId: "@Model.Season.Id",
                matchId: "@Model.Match.Id",
                redirectUrl: "/season/@Model.Season.Id/match/@Model.Match.Id",
                match: @Html.Raw(Model.MatchResultsJson),
                awayPlayers: @Html.Raw(Model.AwayPlayersJson),
                homePlayers: @Html.Raw(Model.HomPlayersJson)
            };
        })(window);
    </script>
    <script src="~/js/scoresheet-edit.js"></script>
}
